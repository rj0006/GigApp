# ------------------------------------------------------------- local secrets
# appsettings.Development.json IS committed here by choice — the repository is
# private. If it ever becomes public, add it back to this list and rotate both
# the JWT signing key and the database password, because git history keeps them.
*.secrets.json

# ------------------------------------------------------------- user uploads
# KYC images are identity documents and profile photos are personal data —
# neither belongs in version control.
GigApp.Api/GigApp.Api/App_Data/
GigApp.Api/GigApp.Api/wwwroot/uploads/

