{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=gigapp_db;Username=postgres;Password=admin"
  },
  // Jwt:Key is intentionally absent here — it is supplied per environment.
  // Development picks it up from appsettings.Development.json; other
  // environments must set Jwt__Key. Startup fails fast if it is missing.
  "Jwt": {
    "Issuer": "GigApp.Api",
    "Audience": "GigApp.Clients",
    "ExpiryMinutes": 10080
  },
  "Cors": {
    "AllowedOrigins": []
  },
  // KycFolder is relative to the content root, NOT wwwroot — identity documents
  // must not be reachable by URL. ProfileFolder is inside wwwroot on purpose.
  "FileStorage": {
    "MaxBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ],
    "ProfileFolder": "uploads/profile",
    "KycFolder": "App_Data/kyc"
  },
  "AllowedHosts": "*"
}
