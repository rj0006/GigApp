@model StorefrontViewModel
@{
    Layout = "_ShopLayout";
}

<div class="shop-hero mb-4">
    <div class="row align-items-center g-3">
        <div class="col-lg-7">
            <h1 class="h3 mb-2">Home services at your doorstep</h1>
            <p class="text-secondary mb-3">
                Fixed prices, verified partners, no haggling. Pick what you need, and we send you
                the nearest available professional.
            </p>
            <a class="btn btn-primary" href="#categories">Browse services</a>
        </div>
        <div class="col-lg-5">
            <div class="row g-2 text-center">
                <div class="col-6">
                    <div class="card"><div class="card-body py-3">
                        <div class="h5 mb-0">Fixed price</div>
                        <div class="small text-secondary">Shown before you book</div>
                    </div></div>
                </div>
                <div class="col-6">
                    <div class="card"><div class="card-body py-3">
                        <div class="h5 mb-0">KYC verified</div>
                        <div class="small text-secondary">Every partner checked</div>
                    </div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Categories.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5 text-secondary">
            No services are listed yet. Please check back shortly.
        </div>
    </div>
}
else
{
    <h2 class="h5 mb-3" id="categories">What do you need done?</h2>

    <div class="catalog-grid mb-5">
        @foreach (var tile in Model.Categories)
        {
            var category = tile.Category;

            <a class="catalog-tile" href="/services/@category.Id">
                <div class="catalog-art">
                    @if (category.ImageUrl is not null)
                    {
                        <img src="@category.ImageUrl" alt="@category.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="catalog-initial">@category.Name.Substring(0, 1).ToUpperInvariant()</span>
                    }
                </div>
                <div class="catalog-body">
                    <div class="catalog-name">@category.Name</div>
                    <div class="catalog-meta">@tile.ServiceCount service@(tile.ServiceCount == 1 ? "" : "s")</div>
                    @if (tile.StartingFrom is not null)
                    {
                        <div class="catalog-price">From ₹@tile.StartingFrom.Value.ToString("N0")</div>
                    }
                </div>
            </a>
        }
    </div>

    @if (Model.Popular.Count > 0)
    {
        <h2 class="h5 mb-3">Most booked services</h2>

        <div class="shop-grid mb-4">
            @foreach (var service in Model.Popular)
            {
                ViewData["CartQuantity"] = Model.Cart.Lines
                    .FirstOrDefault(l => l.ServiceItemId == service.Id)?.Quantity ?? 0;

                <partial name="_ServiceCard" model="service" />
            }
        </div>
    }
}

@if (!Model.Cart.IsEmpty)
{
    @section Sticky {
        <partial name="_CartBar" model="Model.Cart" />
    }
}
