@{
    Layout = "_AdminLayout";
}

<h1 class="h4">Partner approvals</h1>
<p class="text-secondary small">
    Every partner who is not verified yet — waiting for review, rejected, or still to
    upload. Open a row to check the selfie against the Aadhaar card before deciding.
    A partner can neither browse nor accept work until approved.
</p>

<div class="card">
    <div class="card-body">
        <div id="approval-empty" class="text-center text-secondary py-4 mb-0" hidden>Nothing waiting. Every partner is verified.</div>

        <div id="approval-table-wrap" class="table-responsive" hidden>
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th><th>Name</th><th>Mobile</th><th>Skill</th>
                        <th>Aadhaar</th><th>Documents</th><th>Status</th><th>Registered</th>
                        <th class="text-end">Review</th>
                    </tr>
                </thead>
                <tbody id="approval-rows"></tbody>
            </table>
        </div>

        <div id="approval-pager" class="d-flex align-items-center gap-2 mt-3" hidden>
            <span id="approval-pager-summary" class="small text-secondary"></span>
            <div class="btn-group btn-group-sm ms-auto">
                <button type="button" id="approval-prev" class="btn btn-outline-secondary">Previous</button>
                <button type="button" id="approval-next" class="btn btn-outline-secondary">Next</button>
            </div>
        </div>
    </div>
</div>

<partial name="_KycModal" />

@section Scripts {
    <script>
        (function () {
            'use strict';

            var state = { page: 1 };

            function row(partner) {
                var statusCell = '<span class="badge ' + partner.kycBadgeClass + '">' + partner.kycLabel + '</span>';

                if (partner.kycReviewNote) {
                    statusCell += '<div class="small text-primary mt-1" style="max-width:16rem">' + Admin.escapeHtml(partner.kycReviewNote) + '</div>';
                }

                if (partner.isRejected) {
                    statusCell += '<div class="small text-danger mt-1" style="max-width:16rem">' + Admin.escapeHtml(partner.kycRejectionReason || '') + '</div>'
                        + '<div class="small text-secondary">Waiting for them to resubmit.</div>';
                }

                var registered = new Date(partner.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

                return '<tr>'
                    + '<td class="text-secondary">' + partner.id + '</td>'
                    + '<td><div class="fw-semibold">' + Admin.escapeHtml(partner.name) + '</div>'
                    + (partner.email ? '<div class="small text-secondary">' + Admin.escapeHtml(partner.email) + '</div>' : '') + '</td>'
                    + '<td class="mono">' + Admin.escapeHtml(partner.phone) + '</td>'
                    + '<td><span class="badge text-bg-light border">' + Admin.escapeHtml(partner.skillCategoryName) + '</span></td>'
                    + '<td class="mono small">' + (partner.maskedAadhaar || '—') + '</td>'
                    + '<td><span class="badge ' + (partner.hasCompleteKyc ? 'text-bg-info' : 'text-bg-warning') + '">'
                      + (partner.hasCompleteKyc ? 'Complete' : 'Incomplete') + '</span></td>'
                    + '<td>' + statusCell + '</td>'
                    + '<td class="small text-secondary">' + registered + '</td>'
                    + '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" data-review="' + partner.id + '">&#128065; View</button></td>'
                    + '</tr>';
            }

            function load() {
                var url = '/api/partners/all?verified=false&page=' + state.page + '&pageSize=10';

                App.api.get(url).then(function (result) {
                    $('#approval-empty').prop('hidden', result.totalCount > 0);
                    $('#approval-table-wrap').prop('hidden', result.totalCount === 0);
                    $('#approval-pager').prop('hidden', result.totalCount === 0);

                    $('#approval-rows').html(result.items.map(row).join(''));

                    $('#approval-pager-summary').text(result.totalCount === 0
                        ? ''
                        : 'Showing ' + result.firstRow + '–' + result.lastRow + ' of ' + result.totalCount);

                    $('#approval-prev').prop('disabled', !result.hasPrevious);
                    $('#approval-next').prop('disabled', !result.hasNext);
                });
            }

            function openReview(id) {
                Promise.all([
                    App.api.get('/api/partners/' + id),
                    App.api.get('/api/partners/' + id + '/kyc-history'),
                ]).then(function (results) {
                    var partner = results[0], history = results[1];

                    Admin.openKycModal(partner, history, function (approved, reason) {
                        App.api.put('/api/partners/' + id + '/verify', { isVerified: approved, reason: reason }).then(function () {
                            bootstrap.Modal.getInstance(document.getElementById('kyc-modal')).hide();
                            showToast('Success', approved ? partner.name + ' is now verified.' : partner.name + ' was rejected.', 'success');
                            load();
                        });
                    });
                });
            }

            $(function () {
                load();

                $('#approval-prev').on('click', function () { state.page -= 1; load(); });
                $('#approval-next').on('click', function () { state.page += 1; load(); });

                $('#approval-rows').on('click', '[data-review]', function () {
                    openReview($(this).data('review'));
                });
            });
        })();
    </script>
}
