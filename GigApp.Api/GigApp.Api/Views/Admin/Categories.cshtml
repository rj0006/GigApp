@{
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0">Skill categories</h1>
    <a class="btn btn-primary btn-sm ms-auto" href="/admin/masters/categories/new">
        + New category
    </a>
</div>
<p class="text-secondary small">
    Every category picker draws from this master — both partner skills and customer tasks.
</p>

<div class="card">
    <div class="card-body">
        <div class="row g-2 align-items-end mb-3">
            <div class="col-sm-5 col-md-4">
                <label class="form-label" for="category-search">Search</label>
                <input class="form-control form-control-sm" id="category-search" placeholder="Category name" />
            </div>
            <div class="col-auto">
                <button type="button" id="category-search-btn" class="btn btn-sm btn-primary">Search</button>
            </div>
            <div class="col-auto ms-sm-auto">
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" id="category-filter-active" class="btn btn-secondary">Active only</button>
                    <button type="button" id="category-filter-all" class="btn btn-outline-secondary">Show all</button>
                </div>
            </div>
        </div>

        <div id="category-empty" class="text-center text-secondary py-4 mb-0" hidden>
            No categories found.
            <a href="/admin/masters/categories/new">Add the first one</a>.
        </div>

        <div id="category-table-wrap" class="table-responsive" hidden>
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order</th><th>Image</th><th>Name</th><th>Description</th>
                        <th>In use</th><th>Status</th><th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="category-rows"></tbody>
            </table>
        </div>

        <div id="category-pager" class="d-flex align-items-center gap-2 mt-3" hidden>
            <span id="category-pager-summary" class="small text-secondary"></span>
            <div class="btn-group btn-group-sm ms-auto">
                <button type="button" id="category-prev" class="btn btn-outline-secondary">Previous</button>
                <button type="button" id="category-next" class="btn btn-outline-secondary">Next</button>
            </div>
        </div>
    </div>
</div>

<p class="small text-secondary mt-3">
    A category already in use cannot be deleted — deactivate it instead. Deactivating removes it from
    new selections while existing partners and tasks continue to work normally.
</p>

@section Scripts {
    <script>
        (function () {
            'use strict';

            var state = { page: 1, search: '', showInactive: false };

            function usageCell(category) {
                if (category.partnerCount > 0 || category.taskCount > 0) {
                    return '<span class="badge text-bg-light border">' + category.partnerCount + ' partner</span> '
                        + '<span class="badge text-bg-light border">' + category.taskCount + ' task</span>';
                }
                return '<span class="text-secondary">Unused</span>';
            }

            function statusBadge(category) {
                var cls = category.isActive ? 'text-bg-success' : 'text-bg-warning';
                var text = category.isActive ? 'Active' : 'Inactive';
                return '<span class="badge ' + cls + '">' + text + '</span>';
            }

            function row(category) {
                var inUse = category.partnerCount > 0 || category.taskCount > 0;
                var toggleLabel = category.isActive ? 'Deactivate' : 'Activate';

                var actions = ''
                    + '<a class="btn btn-sm btn-outline-secondary" href="/admin/masters/categories/' + category.id + '/edit">Edit</a> '
                    + '<button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="' + category.id
                    + '" data-active="' + category.isActive + '">' + toggleLabel + '</button>';

                if (!inUse) {
                    actions += ' <button type="button" class="btn btn-sm btn-outline-danger" data-delete="' + category.id
                        + '" data-name="' + Admin.escapeHtml(category.name) + '">Delete</button>';
                }

                return '<tr>'
                    + '<td class="text-secondary small">' + category.displayOrder + '</td>'
                    + '<td>' + Admin.thumb(category.imageUrl) + '</td>'
                    + '<td class="fw-semibold">' + Admin.escapeHtml(category.name) + '</td>'
                    + '<td class="small text-secondary">' + Admin.escapeHtml(category.description || '—') + '</td>'
                    + '<td class="small">' + usageCell(category) + '</td>'
                    + '<td>' + statusBadge(category) + '</td>'
                    + '<td><div class="row-actions justify-end">' + actions + '</div></td>'
                    + '</tr>';
            }

            function load() {
                var url = '/api/skillcategories/all?page=' + state.page + '&pageSize=10'
                    + '&showInactive=' + state.showInactive
                    + (state.search ? '&search=' + encodeURIComponent(state.search) : '');

                App.api.get(url).then(function (result) {
                    $('#category-empty').prop('hidden', result.totalCount > 0);
                    $('#category-table-wrap').prop('hidden', result.totalCount === 0);
                    $('#category-pager').prop('hidden', result.totalCount === 0);

                    $('#category-rows').html(result.items.map(row).join(''));

                    $('#category-pager-summary').text(result.totalCount === 0
                        ? ''
                        : 'Showing ' + result.firstRow + '–' + result.lastRow + ' of ' + result.totalCount);

                    $('#category-prev').prop('disabled', !result.hasPrevious);
                    $('#category-next').prop('disabled', !result.hasNext);
                });
            }

            $(function () {
                load();

                $('#category-search-btn').on('click', function () {
                    state.search = $('#category-search').val().trim();
                    state.page = 1;
                    load();
                });

                $('#category-search').on('keydown', function (event) {
                    if (event.which === 13) {
                        event.preventDefault();
                        $('#category-search-btn').click();
                    }
                });

                $('#category-filter-active').on('click', function () {
                    state.showInactive = false;
                    state.page = 1;
                    $(this).removeClass('btn-outline-secondary').addClass('btn-secondary');
                    $('#category-filter-all').removeClass('btn-secondary').addClass('btn-outline-secondary');
                    load();
                });

                $('#category-filter-all').on('click', function () {
                    state.showInactive = true;
                    state.page = 1;
                    $(this).removeClass('btn-outline-secondary').addClass('btn-secondary');
                    $('#category-filter-active').removeClass('btn-secondary').addClass('btn-outline-secondary');
                    load();
                });

                $('#category-prev').on('click', function () { state.page -= 1; load(); });
                $('#category-next').on('click', function () { state.page += 1; load(); });

                $('#category-rows').on('click', '[data-toggle]', function () {
                    var id = $(this).data('toggle');
                    var isActive = String($(this).data('active')) === 'true';

                    App.api.post('/api/skillcategories/' + id + '/toggle', { isActive: !isActive }).then(function (updated) {
                        showToast('Success', updated.isActive
                            ? "'" + updated.name + "' is active and selectable again."
                            : "'" + updated.name + "' deactivated. Existing partners and tasks keep it.", 'success');
                        load();
                    });
                });

                $('#category-rows').on('click', '[data-delete]', function () {
                    var id = $(this).data('delete');
                    var name = $(this).data('name');

                    App.confirmAction({
                        title: 'Delete this category?',
                        text: "Delete '" + name + "'? This cannot be undone.",
                        icon: 'warning',
                    }).then(function (ok) {
                        if (!ok) return;

                        App.api.del('/api/skillcategories/' + id).then(function () {
                            showToast('Success', "Category '" + name + "' deleted.", 'success');
                            load();
                        });
                    });
                });
            });
        })();
    </script>
}
