@model BannerFormViewModel
@{
    Layout = "_AdminLayout";
    var postAction = Model.IsEdit ? "EditBanner" : "NewBanner";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">@Model.Heading</h1>
    <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/masters/banners">Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <partial name="_ValidationSummary" />

        <form method="post" asp-action="@postAction" asp-route-id="@Model.Id"
              enctype="multipart/form-data" class="gig-form row g-3">
            <div class="col-md-8">
                <label asp-for="Form.Title" class="form-label required"></label>
                <input asp-for="Form.Title" class="form-control" autofocus
                       placeholder="Deep clean with foam-jet AC service" />
                <span asp-validation-for="Form.Title" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Form.Placement" class="form-label required"></label>
                <select asp-for="Form.Placement" class="form-select">
                    @foreach (var placement in BannerPlacements.All)
                    {
                        <option value="@placement" selected="@(Model.Form.Placement == placement)">
                            @BannerPlacements.Label(placement)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-8">
                <label asp-for="Form.Subtitle" class="form-label"></label>
                <input asp-for="Form.Subtitle" class="form-control" placeholder="AC service and repair" />
            </div>

            <div class="col-md-4">
                <label asp-for="Form.CallToAction" class="form-label"></label>
                <input asp-for="Form.CallToAction" class="form-control" placeholder="Book now" />
                <div class="form-text">Leave blank for no button.</div>
            </div>

            <div class="col-md-8">
                <label asp-for="Form.LinkUrl" class="form-label"></label>
                <input asp-for="Form.LinkUrl" class="form-control" placeholder="/services/6" />
                <div class="form-text">A page on this site, starting with a slash.</div>
                <span asp-validation-for="Form.LinkUrl" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Form.SortOrder" class="form-label"></label>
                <input asp-for="Form.SortOrder" type="number" min="0" max="9999" class="form-control" />
            </div>

            <div class="col-md-4">
                <label asp-for="Form.StartsAt" class="form-label"></label>
                <input asp-for="Form.StartsAt" type="datetime-local" class="form-control" />
                <div class="form-text">Blank means it is live straight away.</div>
            </div>

            <div class="col-md-4">
                <label asp-for="Form.EndsAt" class="form-label"></label>
                <input asp-for="Form.EndsAt" type="datetime-local" class="form-control" />
                <div class="form-text">Blank means it never expires.</div>
                <span asp-validation-for="Form.EndsAt" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Form.Image",
                    Label = "Banner image",
                    Hint = "A wide image reads best. Required.",
                    CurrentUrl = Model.ImageUrl,
                    Shape = ImageUploadShape.Wide,
                    Required = !Model.IsEdit,
                })" />
                <span asp-validation-for="Form.Image" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Form.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="Form.IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEdit ? "Save changes" : "Create banner")
                </button>
                <a class="btn btn-outline-secondary" href="/admin/masters/banners">Cancel</a>
            </div>
        </form>
    </div>
</div>
