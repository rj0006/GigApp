@model BannerFormShellViewModel
@{
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">@Model.Heading</h1>
    <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/masters/banners">Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <div id="banner-form-errors"></div>

        <form id="banner-form" class="gig-form row g-3">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="col-md-8">
                <label for="banner-title" class="form-label required">Headline</label>
                <input id="banner-title" name="Title" class="form-control" autofocus
                       placeholder="Deep clean with foam-jet AC service" />
            </div>

            <div class="col-md-4">
                <label for="banner-placement" class="form-label required">Placement</label>
                <select id="banner-placement" name="Placement" class="form-select">
                    <option value="spotlight">In the spotlight</option>
                    <option value="wide">Full-width strip</option>
                </select>
            </div>

            <div class="col-md-8">
                <label for="banner-subtitle" class="form-label">Supporting line</label>
                <input id="banner-subtitle" name="Subtitle" class="form-control" placeholder="AC service and repair" />
            </div>

            <div class="col-md-4">
                <label for="banner-cta" class="form-label">Button text</label>
                <input id="banner-cta" name="CallToAction" class="form-control" placeholder="Book now" />
                <div class="form-text">Leave blank for no button.</div>
            </div>

            <div class="col-md-8">
                <label for="banner-link" class="form-label">Links to</label>
                <input id="banner-link" name="LinkUrl" class="form-control" placeholder="/services/6" />
                <div class="form-text">A page on this site, starting with a slash.</div>
            </div>

            <div class="col-md-4">
                <label for="banner-order" class="form-label">Display order</label>
                <input id="banner-order" name="SortOrder" type="number" min="0" max="9999"
                       class="form-control" value="0" />
            </div>

            <div class="col-md-4">
                <label for="banner-starts" class="form-label">Runs from</label>
                <input id="banner-starts" name="StartsAt" type="datetime-local" class="form-control" />
                <div class="form-text">Blank means it is live straight away.</div>
            </div>

            <div class="col-md-4">
                <label for="banner-ends" class="form-label">Runs until</label>
                <input id="banner-ends" name="EndsAt" type="datetime-local" class="form-control" />
                <div class="form-text">Blank means it never expires.</div>
            </div>

            <div class="col-md-4">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Image",
                    Label = "Banner image",
                    Hint = "A wide image reads best. Required.",
                    Shape = ImageUploadShape.Wide,
                })" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input id="banner-active" name="IsActive" class="form-check-input"
                           type="checkbox" value="true" checked />
                    <label for="banner-active" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" id="banner-save" class="btn btn-primary">
                    @(Model.IsEdit ? "Save changes" : "Create banner")
                </button>
                <a class="btn btn-outline-secondary" href="/admin/masters/banners">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            function toLocalInput(isoValue) {
                return isoValue ? isoValue.slice(0, 16) : '';
            }

            function fillForm(banner) {
                $('#banner-title').val(banner.title);
                $('#banner-placement').val(banner.placement);
                $('#banner-subtitle').val(banner.subtitle || '');
                $('#banner-cta').val(banner.callToAction || '');
                $('#banner-link').val(banner.linkUrl || '');
                $('#banner-order').val(banner.sortOrder);
                $('#banner-starts').val(toLocalInput(banner.startsAt));
                $('#banner-ends').val(toLocalInput(banner.endsAt));
                $('#banner-active').prop('checked', banner.isActive);
                Admin.showImagePreview(banner.imageUrl);
            }

            $(function () {
                var form = document.getElementById('banner-form');
                var id = $(form).find('input[name="Id"]').val();

                if (id) {
                    App.api.get('/api/banners/' + id).then(fillForm);
                }

                $(form).on('submit', function (event) {
                    event.preventDefault();
                    $('#banner-form-errors').empty();

                    App.api.post('/api/banners', new FormData(form), { silent: true })
                        .then(function () {
                            showToast('Success', id ? 'Banner updated.' : 'Banner created.', 'success');
                            window.location.href = '/admin/masters/banners';
                        })
                        .catch(function (error) { Admin.showFormErrors('#banner-form-errors', error.message); });
                });
            });
        })();
    </script>
}
