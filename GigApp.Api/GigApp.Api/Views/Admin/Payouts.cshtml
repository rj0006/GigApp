@{
    Layout = "_AdminLayout";
}

<h1 class="h4">Partner payouts</h1>
<p class="text-secondary small">
    What the platform currently owes each partner. A balance builds up as jobs are completed and
    clears when a payout is recorded against it.
</p>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0 text-danger" id="payout-total-owed">₹0.00</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">Total owed</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0" id="payout-awaiting-count">0</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">Partners awaiting payment</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0" id="payout-paid-total">₹0.00</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">Paid out to date</div>
        </div></div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div id="payout-empty" class="text-center text-secondary py-4 mb-0" hidden>No partner has earned anything yet.</div>

        <div id="payout-table-wrap" class="table-responsive" hidden>
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th><th>Partner</th><th>Skill</th>
                        <th class="text-end">Balance</th><th class="text-end">Lifetime earned</th>
                        <th class="text-end">Paid out</th><th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="payout-rows"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            function inr(amount) {
                return '₹' + Number(amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function row(balance) {
                return '<tr>'
                    + '<td class="text-secondary">' + balance.partnerId + '</td>'
                    + '<td><div class="fw-semibold">' + Admin.escapeHtml(balance.partnerName) + '</div>'
                    + '<div class="small text-secondary mono">' + Admin.escapeHtml(balance.phone || '') + '</div></td>'
                    + '<td><span class="badge text-bg-light border">' + Admin.escapeHtml(balance.skillCategoryName || '') + '</span></td>'
                    + '<td class="text-end fw-semibold ' + (balance.balance > 0 ? 'text-success' : 'text-secondary') + '">' + inr(balance.balance) + '</td>'
                    + '<td class="text-end text-secondary">' + inr(balance.lifetimeEarned) + '</td>'
                    + '<td class="text-end text-secondary">' + inr(balance.lifetimePaidOut) + '</td>'
                    + '<td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/admin/payouts/' + balance.partnerId + '">Open</a></td>'
                    + '</tr>';
            }

            $(function () {
                App.api.get('/api/earnings/balances').then(function (balances) {
                    $('#payout-empty').prop('hidden', balances.length > 0);
                    $('#payout-table-wrap').prop('hidden', balances.length === 0);

                    $('#payout-rows').html(balances.map(row).join(''));

                    var totalOwed = balances.reduce(function (sum, b) { return sum + b.balance; }, 0);
                    var totalPaid = balances.reduce(function (sum, b) { return sum + b.lifetimePaidOut; }, 0);
                    var awaiting = balances.filter(function (b) { return b.balance > 0; }).length;

                    $('#payout-total-owed').text(inr(totalOwed));
                    $('#payout-awaiting-count').text(awaiting);
                    $('#payout-paid-total').text(inr(totalPaid));
                });
            });
        })();
    </script>
}
