@model SkillCategoryFormViewModel
@{
    Layout = "_AdminLayout";
    var postAction = Model.IsEdit ? "EditCategory" : "NewCategory";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">@Model.Heading</h1>
    <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/masters/categories">Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <partial name="_ValidationSummary" />

        @if (Model.IsEdit && (Model.PartnerCount > 0 || Model.TaskCount > 0))
        {
            <div class="alert alert-info small">
                <strong>@Model.PartnerCount</strong> partner(s) and <strong>@Model.TaskCount</strong>
                task(s) are using this category. Renaming is safe because they link by id;
                deactivating only stops new selections.
            </div>
        }

        @* Standard form format — see docs/REUSABLE.md *@
        <form method="post" asp-action="@postAction" asp-route-id="@Model.Id"
              enctype="multipart/form-data" class="gig-form row g-3">
            <div class="col-md-8">
                <label asp-for="Form.Name" class="form-label required"></label>
                <input asp-for="Form.Name" class="form-control" autofocus placeholder="Plumbing" />
                <span asp-validation-for="Form.Name" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Form.DisplayOrder" class="form-label"></label>
                <input asp-for="Form.DisplayOrder" type="number" min="0" max="9999" class="form-control" />
                <div class="form-text">Lower numbers appear first in pickers.</div>
            </div>

            <div class="col-md-8">
                <label asp-for="Form.Description" class="form-label"></label>
                <textarea asp-for="Form.Description" class="form-control" rows="3"
                          placeholder="Taps, pipes, leaks, bathroom and kitchen fittings"></textarea>
            </div>

            <div class="col-md-4">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Image",
                    Label = "Category image",
                    Hint = "Shown on the customer home page. A wide photo of the work reads best.",
                    CurrentUrl = Model.ImageUrl,
                    Shape = ImageUploadShape.Wide,
                })" />
                <span asp-validation-for="Form.Image" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="Form.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="Form.IsActive" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEdit ? "Save changes" : "Create category")
                </button>
                <a class="btn btn-outline-secondary" href="/admin/masters/categories">Cancel</a>
            </div>
        </form>
    </div>
</div>
