@model CategoryFormShellViewModel
@{
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0" id="category-form-heading">@Model.Heading</h1>
    <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/masters/categories">Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <div id="category-form-usage-note" class="alert alert-info small" hidden></div>

        <div id="category-form-errors"></div>

        <form id="category-form" class="gig-form row g-3">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="col-md-8">
                <label for="category-name" class="form-label required">Category name</label>
                <input id="category-name" name="Name" class="form-control" autofocus placeholder="Plumbing" />
            </div>

            <div class="col-md-4">
                <label for="category-order" class="form-label">Display order</label>
                <input id="category-order" name="DisplayOrder" type="number" min="0" max="9999"
                       class="form-control" value="0" />
                <div class="form-text">Lower numbers appear first in pickers.</div>
            </div>

            <div class="col-md-8">
                <label for="category-description" class="form-label">Description</label>
                <textarea id="category-description" name="Description" class="form-control" rows="3"
                          placeholder="Taps, pipes, leaks, bathroom and kitchen fittings"></textarea>
            </div>

            <div class="col-md-4">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Image",
                    Label = "Category image",
                    Hint = "Shown on the customer home page. A wide photo of the work reads best.",
                    Shape = ImageUploadShape.Wide,
                })" />
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input id="category-active" name="IsActive" class="form-check-input" type="checkbox" value="true" checked />
                    <label for="category-active" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" id="category-save" class="btn btn-primary">
                    @(Model.IsEdit ? "Save changes" : "Create category")
                </button>
                <a class="btn btn-outline-secondary" href="/admin/masters/categories">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            function fillForm(category) {
                $('#category-name').val(category.name);
                $('#category-description').val(category.description || '');
                $('#category-order').val(category.displayOrder);
                $('#category-active').prop('checked', category.isActive);
                Admin.showImagePreview(category.imageUrl);

                if (category.partnerCount > 0 || category.taskCount > 0) {
                    $('#category-form-usage-note').prop('hidden', false).html(
                        '<strong>' + category.partnerCount + '</strong> partner(s) and <strong>' + category.taskCount
                        + '</strong> task(s) are using this category. Renaming is safe because they link by id; '
                        + 'deactivating only stops new selections.');
                }
            }

            $(function () {
                var form = document.getElementById('category-form');
                var id = $(form).find('input[name="Id"]').val();

                if (id) {
                    App.api.get('/api/skillcategories/' + id).then(fillForm);
                }

                $(form).on('submit', function (event) {
                    event.preventDefault();
                    $('#category-form-errors').empty();

                    App.api.post('/api/skillcategories', new FormData(form), { silent: true })
                        .then(function () {
                            showToast('Success', id ? 'Category updated.' : 'Category created.', 'success');
                            window.location.href = '/admin/masters/categories';
                        })
                        .catch(function (error) { Admin.showFormErrors('#category-form-errors', error.message); });
                });
            });
        })();
    </script>
}
