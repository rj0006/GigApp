@model AdminTasksViewModel
@{
    Layout = "_AdminLayout";
    var list = Model.Tasks;
}

<h1 class="h4">Tasks</h1>
<p class="text-secondary small"><strong>@list.TotalCount</strong> task(s) in total.</p>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-sm-4 col-md-3">
                <label class="form-label" for="search">Search</label>
                <input class="form-control form-control-sm" id="search" name="search"
                       value="@list.Search" placeholder="Description or address" />
            </div>
            <div class="col-sm-3 col-md-2">
                <label class="form-label" for="status">Status</label>
                <select class="form-select form-select-sm" id="status" name="status">
                    <option value="" selected="@string.IsNullOrEmpty(Model.StatusFilter)">All</option>
                    @foreach (var status in GigTaskStatus.All)
                    {
                        <option value="@status" selected="@(Model.StatusFilter == status)">
                            @status.Replace('_', ' ')
                        </option>
                    }
                </select>
            </div>
            <div class="col-sm-3 col-md-3">
                <label class="form-label" for="categoryId">Category</label>
                <select class="form-select form-select-sm" id="categoryId" name="categoryId">
                    <option value="" selected="@(Model.CategoryFilter is null)">All</option>
                    @foreach (var option in Model.Categories)
                    {
                        <option value="@option.Id" selected="@(Model.CategoryFilter == option.Id)">@option.Name</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                <a class="btn btn-sm btn-outline-secondary" href="/admin/tasks">Reset</a>
            </div>
        </form>

        @if (list.TotalCount == 0)
        {
            <p class="text-center text-secondary py-4 mb-0">No tasks match this filter.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th><th>Category</th><th>Description</th><th>Address</th>
                            <th>Customer</th><th>Partner</th><th>Amount</th><th>Status</th><th>Created</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var task in list.Items)
                    {
                        <tr>
                            <td class="text-secondary">@task.Id</td>
                            <td>
                                <span class="badge text-bg-light border">@task.CategoryName</span>
                                @if (task.IsInstant)
                                {
                                    <span class="badge text-bg-success">Fixed price</span>
                                }
                                @if (task.Urgency != TaskUrgency.Normal)
                                {
                                    <div class="mt-1">
                                        <span class="badge @task.UrgencyBadgeClass">@task.UrgencyLabel</span>
                                    </div>
                                }
                            </td>
                            <td class="small">@task.Description</td>
                            <td class="small text-secondary">@task.Address</td>
                            <td>@(task.CustomerName ?? "—")</td>
                            <td>
                                @(task.PartnerName ?? "—")
                                @if (task.AssignedAt is not null)
                                {
                                    <div class="small text-secondary" style="max-width:16rem">
                                        Assigned by @(task.AssignedByName ?? "support")
                                        on @task.AssignedAt.Value.ToString("dd MMM yyyy")
                                        <div class="fst-italic">@task.AssignmentNote</div>
                                    </div>
                                }
                            </td>
                            <td>₹@task.EffectiveAmount.ToString("N0")</td>
                            <td><span class="badge badge-@task.Status text-white">@task.StatusLabel</span></td>
                            <td class="small text-secondary">@task.CreatedAt.ToString("dd MMM, HH:mm")</td>
                            <td class="text-end">
                                @if (task.Status == GigTaskStatus.Pending)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            data-bs-toggle="modal" data-bs-target="#assign-modal-@task.Id">
                                        Assign
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <partial name="_Pagination" model="PagerModel.From(list, Context)" />

            @foreach (var task in list.Items.Where(t => t.Status == GigTaskStatus.Pending))
            {
                <div class="modal fade" id="assign-modal-@task.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <form method="post" asp-action="AssignTask" asp-route-id="@task.Id" class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Assign task #@task.Id</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body gig-form">
                                <p class="small text-secondary mb-3">
                                    @task.Description<br />
                                    <span class="text-body">@task.Address</span> ·
                                    @task.CategoryName · <strong>₹@task.EffectiveAmount.ToString("N0")</strong>
                                </p>
                                @{ var ranked = Model.SuggestionsFor(task.Id); }

                                @if (ranked.Count > 0)
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Best matches</label>
                                        <div class="list-group match-list">
                                            @foreach (var match in ranked)
                                            {
                                                <label class="list-group-item d-flex align-items-center gap-2">
                                                    <input class="form-check-input m-0" type="radio"
                                                           name="partnerId" value="@match.PartnerId" required />
                                                    <span class="flex-grow-1">
                                                        <span class="fw-semibold">@match.Name</span>
                                                        <span class="mono small text-secondary">@match.Phone</span>
                                                        <span class="d-block small">
                                                            <partial name="_Stars" model="match.RoundedRating" />
                                                            @if (match.RatingCount > 0)
                                                            {
                                                                <span class="text-secondary">@match.AverageRating!.Value.ToString("0.0") · @match.RatingCount</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-secondary">no ratings yet</span>
                                                            }
                                                        </span>
                                                    </span>
                                                    <span class="text-end small">
                                                        <span class="badge @(match.HasLocation ? "text-bg-light border" : "text-bg-warning")">
                                                            @match.DistanceLabel
                                                        </span>
                                                        @if (match.IsOutOfRange)
                                                        {
                                                            <div class="text-warning-emphasis">past their @match.ServiceRadiusKm km limit</div>
                                                        }
                                                        @if (!match.IsAvailable)
                                                        {
                                                            <div class="text-secondary">off duty</div>
                                                        }
                                                    </span>
                                                </label>
                                            }
                                        </div>
                                        <div class="form-text">
                                            Ranked by distance and rating. Anyone past their own travel
                                            limit or off duty is pushed down, not hidden.
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning small">
                                        No approved partner works in @task.CategoryName yet.
                                    </div>
                                }
                                <div>
                                    <label for="assign-note-@task.Id" class="form-label required">Why this partner</label>
                                    <textarea id="assign-note-@task.Id" name="note" class="form-control" rows="2"
                                              required maxlength="300"
                                              placeholder="Customer called and asked for a partner who can come today"></textarea>
                                    <div class="form-text">
                                        The customer and the partner both see this task as assigned, so
                                        write what the next person needs to know.
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-primary">Assign partner</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>
