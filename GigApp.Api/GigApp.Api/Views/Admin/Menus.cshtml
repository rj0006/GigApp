@model AdminMenusViewModel
@{
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0">Menu</h1>
    <a class="btn btn-primary btn-sm ms-auto" href="/admin/masters/menu/new">+ New item</a>
</div>
<p class="text-secondary small">
    The admin sidebar is built from these rows. A row with no controller, action or URL becomes a
    group heading; everything else is a link. Order inside a group follows the sort order.
</p>

<div class="card">
    <div class="card-body">
        @if (Model.Items.Count == 0)
        {
            <p class="text-center text-secondary py-4 mb-0">The menu is empty.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th><th>Label</th><th>Target</th><th>Icon</th>
                            <th>Order</th><th>Visible to</th><th>Status</th><th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsGroup ? "table-light" : "")">
                            <td class="text-secondary">@item.Id</td>
                            <td>
                                @if (item.ParentId is not null)
                                {
                                    <span class="text-secondary">&mdash;&nbsp;</span>
                                }
                                <span class="@(item.IsGroup ? "fw-semibold text-uppercase small" : "")">@item.Label</span>
                            </td>
                            <td class="small mono">@item.Target</td>
                            <td>@item.Icon</td>
                            <td class="small text-secondary">@item.SortOrder</td>
                            <td class="small text-secondary">@item.VisibilityLabel</td>
                            <td>
                                <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsActive ? "Active" : "Hidden")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="row-actions justify-end">
                                    <a class="btn btn-sm btn-outline-primary" href="/admin/masters/menu/@item.Id">Edit</a>
                                    <form method="post" action="/admin/masters/menu/@item.Id/delete"
                                          data-confirm-title="Remove this menu item?"
                                          data-confirm="@($"{item.Label} will disappear from the sidebar. Hiding it instead keeps the row for later.")"
                                          data-confirm-ok="Yes, remove it">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
