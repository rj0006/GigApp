@model AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
}

<h1 class="h4">Hello, @Model.Name</h1>
<p class="text-secondary small">Platform activity at a glance.</p>

<div class="row g-3 mb-2">
    @foreach (var tile in new[] {
        ("Customers", Model.CustomerCount),
        ("Partners", Model.PartnerCount),
        ("Awaiting KYC", Model.PendingKycCount),
        ("Open tasks", Model.OpenTaskCount),
        ("Active categories", Model.CategoryCount) })
    {
        <div class="col-6 col-md-4 col-xl">
            <div class="card h-100">
                <div class="card-body py-3">
                    <div class="h4 mb-0">@tile.Item2</div>
                    <div class="text-secondary text-uppercase" style="font-size:.68rem;letter-spacing:.05em">
                        @tile.Item1
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <h2 class="h6 mb-0">Awaiting approval</h2>
            <a class="btn btn-sm btn-outline-secondary ms-auto" href="/admin/approvals">View all</a>
        </div>

        @if (Model.PendingPartners.Count == 0)
        {
            <p class="text-center text-secondary py-3 mb-0">Nothing waiting. Every partner is verified.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>Name</th><th>Mobile</th><th>Skill</th><th>KYC</th><th>Registered</th></tr></thead>
                    <tbody>
                    @foreach (var partner in Model.PendingPartners)
                    {
                        <tr>
                            <td class="fw-semibold">@partner.Name</td>
                            <td class="mono">@partner.Phone</td>
                            <td><span class="badge text-bg-light border">@partner.SkillCategoryName</span></td>
                            <td class="small">
                                @if (partner.HasCompleteKyc)
                                {
                                    <a href="/admin/approvals">Review</a>
                                }
                                else
                                {
                                    <span class="text-secondary">Incomplete</span>
                                }
                            </td>
                            <td class="small text-secondary">@partner.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <h2 class="h6 mb-0">Recent tasks</h2>
            <a class="btn btn-sm btn-outline-secondary ms-auto" href="/admin/tasks">View all</a>
        </div>

        @if (Model.RecentTasks.Count == 0)
        {
            <p class="text-center text-secondary py-3 mb-0">No tasks have been posted yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr><th>#</th><th>Category</th><th>Customer</th><th>Partner</th><th>Budget</th><th>Status</th><th>Created</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var task in Model.RecentTasks)
                    {
                        <tr>
                            <td class="text-secondary">@task.Id</td>
                            <td><span class="badge text-bg-light border">@task.CategoryName</span></td>
                            <td>@(task.CustomerName ?? "—")</td>
                            <td>@(task.PartnerName ?? "—")</td>
                            <td>₹@task.Budget.ToString("N0")</td>
                            <td><span class="badge badge-@task.Status text-white">@task.StatusLabel</span></td>
                            <td class="small text-secondary">@task.CreatedAt.ToString("dd MMM, HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
