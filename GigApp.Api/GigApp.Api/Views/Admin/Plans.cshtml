@{
    Layout = "_AdminLayout";
    var isSuperAdmin = ViewData["IsSuperAdmin"] is true;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h1 class="h4 mb-0">Commission plans</h1>
    @if (isSuperAdmin)
    {
        <a class="btn btn-primary btn-sm ms-auto" href="/admin/masters/plans/new">+ New plan</a>
    }
</div>
<p class="text-secondary small">
    What the platform keeps from each job. A plan with a fee and zero commission is the subscription
    model — the partner pays up front and keeps everything they earn. Changing a plan never touches
    jobs that are already settled; the rate is written onto the ledger when the job completes.
</p>

<div class="card">
    <div class="card-body">
        <div class="mb-3">
            <select id="plan-filter" class="form-select form-select-sm" style="max-width:16rem">
                <option value="false">Active plans</option>
                <option value="true">Include retired plans</option>
            </select>
        </div>

        <div id="plan-empty" class="text-center text-secondary py-4 mb-0" hidden>No plans yet.</div>

        <div id="plan-table-wrap" class="table-responsive" hidden>
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th><th>Plan</th><th class="text-end">Commission</th>
                        <th class="text-end">Fee</th><th>Charged</th>
                        <th class="text-end">Partners</th><th>Status</th><th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="plan-rows" data-is-super-admin="@(isSuperAdmin ? "true" : "false")"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            function row(plan, isSuperAdmin) {
                var defaultBadge = plan.isDefault ? '<span class="badge text-bg-primary ms-1">Default</span>' : '';
                var description = plan.description
                    ? '<div class="small text-secondary">' + Admin.escapeHtml(plan.description) + '</div>'
                    : '';
                var fee = plan.subscriptionFee > 0 ? '₹' + plan.subscriptionFee.toFixed(2) : '—';
                var statusCls = plan.isActive ? 'text-bg-success' : 'text-bg-secondary';
                var statusText = plan.isActive ? 'Active' : 'Retired';
                var editLink = isSuperAdmin
                    ? '<a class="btn btn-sm btn-outline-primary" href="/admin/masters/plans/' + plan.id + '">Edit</a>'
                    : '';

                return '<tr>'
                    + '<td class="text-secondary">' + plan.id + '</td>'
                    + '<td><div class="fw-semibold">' + Admin.escapeHtml(plan.name) + defaultBadge + '</div>'
                    + '<div class="small text-secondary mono">' + Admin.escapeHtml(plan.code) + '</div>' + description + '</td>'
                    + '<td class="text-end fw-semibold ' + (plan.isZeroCommission ? 'text-success' : '') + '">'
                    + plan.commissionPercent.toFixed(2).replace(/\.?0+$/, '') + '%</td>'
                    + '<td class="text-end">' + fee + '</td>'
                    + '<td class="small text-secondary">' + Admin.escapeHtml(plan.billingLabel) + '</td>'
                    + '<td class="text-end">' + plan.partnersOnPlan + '</td>'
                    + '<td><span class="badge ' + statusCls + '">' + statusText + '</span></td>'
                    + '<td class="text-end">' + editLink + '</td>'
                    + '</tr>';
            }

            function load() {
                var showInactive = $('#plan-filter').val() === 'true';
                var isSuperAdmin = $('#plan-rows').data('is-super-admin') === true || $('#plan-rows').data('is-super-admin') === 'true';

                App.api.get('/api/commissionplans?showInactive=' + showInactive).then(function (plans) {
                    $('#plan-empty').prop('hidden', plans.length > 0);
                    $('#plan-table-wrap').prop('hidden', plans.length === 0);
                    $('#plan-rows').html(plans.map(function (p) { return row(p, isSuperAdmin); }).join(''));
                });
            }

            $(function () {
                load();
                $('#plan-filter').on('change', load);
            });
        })();
    </script>
}
