@model ServiceItemFormViewModel
@{
    Layout = "_AdminLayout";
    var postAction = Model.IsEdit ? "EditService" : "NewService";
    var selectedCategory = Model.Categories.FirstOrDefault(c => c.Id == Model.Form.SkillCategoryId)?.Name;
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">@Model.Heading</h1>
    <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/masters/services">Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <partial name="_ValidationSummary" />

        @if (Model.IsEdit && Model.TaskCount > 0)
        {
            <div class="alert alert-info small">
                <strong>@Model.TaskCount</strong> task(s) use this service. Renaming is safe because
                they link by id; deactivating only stops new bookings.
            </div>
        }

        <form method="post" asp-action="@postAction" asp-route-id="@Model.Id"
              enctype="multipart/form-data" class="gig-form row g-3">
            <div class="col-md-6">
                <label for="CategoryPicker" class="form-label required">Category</label>
                <input id="CategoryPicker" class="form-control" placeholder="Start typing to choose"
                       data-master="skill-category" data-target="SkillCategoryId"
                       data-alert="category" value="@selectedCategory" />
                <input type="hidden" asp-for="Form.SkillCategoryId" id="SkillCategoryId" />
            </div>

            <div class="col-md-6">
                <label asp-for="Form.Name" class="form-label required"></label>
                <input asp-for="Form.Name" class="form-control" autofocus placeholder="Tap repair" />
            </div>

            <div class="col-md-8">
                <label asp-for="Form.Description" class="form-label"></label>
                <textarea asp-for="Form.Description" class="form-control" rows="2"
                          placeholder="What this job covers"></textarea>
            </div>

            <div class="col-md-4">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Form.Image",
                    Label = "Service image",
                    Hint = "Shown on the storefront next to the price.",
                    CurrentUrl = Model.ImageUrl,
                    Shape = ImageUploadShape.Wide,
                })" />
                <span asp-validation-for="Form.Image" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Form.BasePayout" class="form-label"></label>
                <input asp-for="Form.BasePayout" type="number" min="0" step="10" class="form-control" />
                <div class="form-text">
                    What the partner is paid. Leave blank until completed work shows a real rate —
                    see <a href="/admin/masters/pricing">price insights</a>.
                </div>
            </div>

            <div class="col-md-4">
                <label asp-for="Form.DisplayOrder" class="form-label"></label>
                <input asp-for="Form.DisplayOrder" type="number" min="0" max="9999" class="form-control" />
                <div class="form-text">Lower numbers appear first.</div>
            </div>

            <div class="col-md-4 d-flex flex-column justify-content-end">
                <div class="form-check">
                    <input asp-for="Form.AllowsInstantBooking" class="form-check-input" type="checkbox" />
                    <label asp-for="Form.AllowsInstantBooking" class="form-check-label"></label>
                </div>
                <div class="form-check">
                    <input asp-for="Form.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="Form.IsActive" class="form-check-label"></label>
                </div>
                <div class="form-text">Instant booking needs a payout set.</div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEdit ? "Save changes" : "Create service")
                </button>
                <a class="btn btn-outline-secondary" href="/admin/masters/services">Cancel</a>
            </div>
        </form>
    </div>
</div>
