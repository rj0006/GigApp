@model ServiceFormShellViewModel
@{
    Layout = "_AdminLayout";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">@Model.Heading</h1>
    <a class="btn btn-outline-secondary btn-sm ms-auto" href="/admin/masters/services">Back to list</a>
</div>

<div class="card form-card">
    <div class="card-body">
        <div id="service-form-usage-note" class="alert alert-info small" hidden></div>
        <div id="service-form-errors"></div>

        <form id="service-form" class="gig-form row g-3">
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="col-md-6">
                <label for="CategoryPicker" class="form-label required">Category</label>
                <input id="CategoryPicker" class="form-control" placeholder="Start typing to choose"
                       data-master="skill-category" data-target="SkillCategoryId" data-alert="category" />
                <input type="hidden" name="SkillCategoryId" id="SkillCategoryId" />
            </div>

            <div class="col-md-6">
                <label for="service-name" class="form-label required">Service name</label>
                <input id="service-name" name="Name" class="form-control" autofocus placeholder="Tap repair" />
            </div>

            <div class="col-md-8">
                <label for="service-description" class="form-label">Description</label>
                <textarea id="service-description" name="Description" class="form-control" rows="2"
                          placeholder="What this job covers"></textarea>
            </div>

            <div class="col-md-4">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Image",
                    Label = "Service image",
                    Hint = "Shown on the storefront next to the price.",
                    Shape = ImageUploadShape.Wide,
                })" />
            </div>

            <div class="col-md-4">
                <label for="service-payout" class="form-label">Partner payout (₹)</label>
                <input id="service-payout" name="BasePayout" type="number" min="0" step="10" class="form-control" />
                <div class="form-text">
                    What the partner is paid. Leave blank until completed work shows a real rate —
                    see <a href="/admin/masters/pricing">price insights</a>.
                </div>
            </div>

            <div class="col-md-4">
                <label for="service-order" class="form-label">Display order</label>
                <input id="service-order" name="DisplayOrder" type="number" min="0" max="9999"
                       class="form-control" value="0" />
                <div class="form-text">Lower numbers appear first.</div>
            </div>

            <div class="col-md-4 d-flex flex-column justify-content-end">
                <div class="form-check">
                    <input id="service-instant" name="AllowsInstantBooking" class="form-check-input"
                           type="checkbox" value="true" />
                    <label for="service-instant" class="form-check-label">Allow instant booking</label>
                </div>
                <div class="form-check">
                    <input id="service-active" name="IsActive" class="form-check-input"
                           type="checkbox" value="true" checked />
                    <label for="service-active" class="form-check-label">Active</label>
                </div>
                <div class="form-text">Instant booking needs a payout set.</div>
            </div>

            <div class="col-12 d-flex gap-2 pt-2">
                <button type="submit" id="service-save" class="btn btn-primary">
                    @(Model.IsEdit ? "Save changes" : "Create service")
                </button>
                <a class="btn btn-outline-secondary" href="/admin/masters/services">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            function fillForm(item) {
                $('#CategoryPicker').val(item.categoryName);
                $('#SkillCategoryId').val(item.skillCategoryId);
                $('#service-name').val(item.name);
                $('#service-description').val(item.description || '');
                $('#service-payout').val(item.basePayout != null ? item.basePayout : '');
                $('#service-order').val(item.displayOrder);
                $('#service-instant').prop('checked', item.allowsInstantBooking);
                $('#service-active').prop('checked', item.isActive);
                Admin.showImagePreview(item.imageUrl);

                if (item.taskCount > 0) {
                    $('#service-form-usage-note').prop('hidden', false).html(
                        '<strong>' + item.taskCount + '</strong> task(s) use this service. Renaming is safe because '
                        + 'they link by id; deactivating only stops new bookings.');
                }
            }

            $(function () {
                var form = document.getElementById('service-form');
                var id = $(form).find('input[name="Id"]').val();

                if (id) {
                    App.api.get('/api/serviceitems/' + id).then(fillForm);
                }

                $(form).on('submit', function (event) {
                    event.preventDefault();
                    $('#service-form-errors').empty();

                    App.api.post('/api/serviceitems', new FormData(form), { silent: true })
                        .then(function () {
                            showToast('Success', id ? 'Service updated.' : 'Service created.', 'success');
                            window.location.href = '/admin/masters/services';
                        })
                        .catch(function (error) { Admin.showFormErrors('#service-form-errors', error.message); });
                });
            });
        })();
    </script>
}
