@{
    var reference = Context.Request.Query["reference"].ToString();
}

<div class="card form-card-narrow mx-auto">
    <div class="card-body p-4 text-center">
        <h1 class="h5">Something went wrong</h1>
        <p class="text-secondary small">
            The request could not be completed. Please try again, or go back to the start.
        </p>

        @if (!string.IsNullOrWhiteSpace(reference))
        {
            <p class="small mb-3">
                Quote this reference if you report it:<br />
                <span class="mono fw-semibold">@reference</span>
            </p>
        }

        <a class="btn btn-primary" href="/">Back to home</a>
    </div>
</div>
