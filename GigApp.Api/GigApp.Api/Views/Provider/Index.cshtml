@model ProviderDashboardViewModel
@{
    ViewData["Portal"] = "Partner";
    ViewData["LogoutPath"] = "/provider/logout";
    var profile = Model.Profile;
}

<h1 class="h4">Hello, @Model.Name</h1>

@if (profile is null)
{
    <div class="alert alert-danger">
        No partner profile is attached to this account. Please contact an administrator.
    </div>
}
else if (!profile.IsVerified)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <span class="badge @profile.KycBadgeClass mb-3" style="font-size:.9rem">@profile.KycLabel</span>

            @if (profile.IsRejected)
            {
                <h2 class="h5">Your KYC was rejected</h2>
                <p class="text-secondary mb-2">
                    @profile.KycRejectionReason
                </p>
                <p class="text-secondary small">
                    Fix the problem and upload the document again. That puts you straight back
                    into the review queue — you do not need a new account.
                </p>
            }
            else if (profile.HasCompleteKyc)
            {
                <h2 class="h5">Your documents are under review</h2>
                <p class="text-secondary mb-2">
                    An administrator is checking them. You will be able to see and bid on work
                    as soon as they approve.
                </p>
                @if (!string.IsNullOrWhiteSpace(profile.KycReviewNote))
                {
                    <p class="text-secondary small">@profile.KycReviewNote</p>
                }
            }
            else
            {
                <h2 class="h5">Your KYC is incomplete</h2>
                <p class="text-secondary mb-2">
                    Upload your selfie, both sides of your Aadhaar card and your Aadhaar number
                    to start the review.
                </p>
            }

            <a class="btn btn-primary mt-2" href="/provider/profile/kyc">Go to KYC</a>
        </div>
    </div>

    @if (Model.HasOpenJobs)
    {
        <div class="alert alert-warning mt-3">
            <strong>You still have work in hand.</strong>
            Jobs you had already accepted are listed below so a customer is not left waiting.
            Finish them as agreed. New work stays hidden until your KYC is approved again.
        </div>

        <partial name="_MyJobs" model="Model" />
    }
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body py-3">
                <div class="h6 mb-0">@profile.SkillCategoryName</div>
                <div class="text-secondary text-uppercase" style="font-size:.68rem">Skill category</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body py-3">
                <span class="badge @profile.KycBadgeClass">@profile.KycLabel</span>
                <div class="text-secondary text-uppercase mt-1" style="font-size:.68rem">KYC status</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body py-3">
                <partial name="_Stars" model="profile.RoundedRating" />
                <div class="text-secondary text-uppercase mt-1" style="font-size:.68rem">
                    @(profile.RatingCount > 0
                        ? $"{profile.AverageRating:0.0} from {profile.RatingCount} customer{(profile.RatingCount == 1 ? "" : "s")}"
                        : "Your rating — no customer has rated you yet")
                </div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card h-100"><div class="card-body py-3">
                <form method="post" asp-action="ToggleAvailability" class="d-inline">
                    <input type="hidden" name="isAvailable" value="@(profile.IsAvailable ? "false" : "true")" />
                    <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent">
                        <span class="badge @(profile.IsAvailable ? "text-bg-success" : "text-bg-secondary")">
                            @(profile.IsAvailable ? "On duty" : "Off duty")
                        </span>
                    </button>
                </form>
                <div class="text-secondary text-uppercase mt-1" style="font-size:.68rem">
                    Availability — click to change
                </div>
            </div></div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 mb-3">Available work</h2>

            @if (!profile.IsVerified)
            {
                <p class="text-center text-secondary py-4 mb-0">Open tasks appear here once your account is verified.</p>
            }
            else if (Model.AvailableTasks.Count == 0)
            {
                <p class="text-center text-secondary py-4 mb-0">
                    Nothing new in your category right now. Anything you have already bid on is under
                    <strong>My bids</strong>.
                </p>
            }
            else
            {
                <p class="text-secondary small">
                    On a bidding job you quote your own amount and the customer decides. A
                    <strong>fixed price</strong> job has no bidding — the first partner to accept it
                    gets the work at the listed rate.
                </p>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr><th>#</th><th>Category</th><th>Description</th><th>Address</th><th>Amount</th><th>Customer</th><th class="text-end"></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var task in Model.AvailableTasks)
                        {
                            <tr class="@(task.IsUrgent ? "table-danger" : "")">
                                <td class="text-secondary">@task.Id</td>
                                <td>
                                    <div>@(task.ServiceItemName ?? task.CategoryName)</div>
                                    <span class="badge text-bg-light border">@task.CategoryName</span>
                                    @if (task.IsInstant)
                                    {
                                        <span class="badge text-bg-success">Fixed price</span>
                                    }
                                    @if (task.Urgency != TaskUrgency.Normal)
                                    {
                                        <div class="mt-1">
                                            <span class="badge @task.UrgencyBadgeClass">@task.UrgencyLabel</span>
                                        </div>
                                    }
                                </td>
                                <td class="small">@task.Description</td>
                                <td class="small text-secondary">@task.Address</td>
                                <td>
                                    <span class="fw-semibold">₹@task.EffectiveAmount.ToString("N0")</span>
                                    <div class="small text-secondary">@(task.IsInstant ? "fixed" : "budget")</div>
                                </td>
                                <td>@(task.CustomerName ?? "—")</td>
                                <td class="text-end">
                                    @if (task.IsInstant)
                                    {
                                        <form method="post" asp-action="AcceptTask" asp-route-id="@task.Id"
                                              data-confirm-title="Take this job?"
                                              data-confirm="@($"You will earn ₹{task.EffectiveAmount:N0} before commission for {task.ServiceItemName ?? task.CategoryName} at {task.Address}. The price is fixed and the job becomes yours immediately.")"
                                              data-confirm-icon="question"
                                              data-confirm-ok="Yes, take it">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                Accept at ₹@task.EffectiveAmount.ToString("N0")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-primary"
                                                data-bs-toggle="modal" data-bs-target="#bid-modal-@task.Id">
                                            Place bid
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @foreach (var task in Model.AvailableTasks.Where(t => !t.IsInstant))
                {
                    <div class="modal fade" id="bid-modal-@task.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <form method="post" asp-action="PlaceBid" asp-route-id="@task.Id" class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Bid on task #@task.Id</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body gig-form">
                                    <p class="small text-secondary mb-3">
                                        @task.Description<br />
                                        <span class="text-body">@task.Address</span> ·
                                        customer's budget <strong>₹@task.Budget.ToString("N0")</strong>
                                    </p>
                                    <div class="mb-3">
                                        <label for="amount-@task.Id" class="form-label required">Your amount (₹)</label>
                                        <input id="amount-@task.Id" name="Amount" type="number" min="1" step="50"
                                               class="form-control" required value="@task.Budget.ToString("0")" />
                                        <div class="form-text">You can ask for more or less than the budget.</div>
                                    </div>
                                    <div>
                                        <label for="note-@task.Id" class="form-label">Message to the customer</label>
                                        <textarea id="note-@task.Id" name="Note" class="form-control" rows="2"
                                                  maxlength="500" placeholder="Why you are a good fit"></textarea>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-sm btn-primary">Send bid</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h6 mb-3">
                My bids
                @if (Model.CountersAwaitingReply > 0)
                {
                    <span class="badge text-bg-warning">@Model.CountersAwaitingReply need a reply</span>
                }
            </h2>
            <partial name="_MyBids" model="Model.MyBids" />
        </div>
    </div>

    <partial name="_MyJobs" model="Model" />
}
