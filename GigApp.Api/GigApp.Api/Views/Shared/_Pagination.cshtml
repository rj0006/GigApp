@model GigApp.Api.ViewModels.PagerModel
@*
    Server-side pager. Keeps every existing query-string value (filters, search)
    and only swaps `page`, so filters survive paging.
    Usage: <partial name="_Pagination" model="PagerModel.From(Model.Page, Context)" />
*@
@if (Model.TotalPages > 1 || Model.TotalCount > 0)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
        <span class="small text-secondary">
            Showing <strong>@Model.FirstRow</strong>–<strong>@Model.LastRow</strong>
            of <strong>@Model.TotalCount</strong>
        </span>

        @if (Model.TotalPages > 1)
        {
            <nav class="ms-auto" aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" href="@Model.UrlFor(Model.CurrentPage - 1)">Prev</a>
                    </li>

                    @foreach (var pageNumber in Model.VisiblePages)
                    {
                        if (pageNumber < 0)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        else
                        {
                            <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Model.UrlFor(pageNumber)">@pageNumber</a>
                            </li>
                        }
                    }

                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" href="@Model.UrlFor(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
