@model ProviderDashboardViewModel
@{
    var profile = Model.Profile!;
}

    <div class="card">
        <div class="card-body">
            <h2 class="h6 mb-1">My jobs</h2>
            <p class="text-secondary small">
                @(profile.IsVerified
                    ? "Only tasks the customer has assigned to you."
                    : "Work you had already accepted. You can still finish these while your KYC is reviewed.")
            </p>

            @if (Model.MyJobs.Count == 0)
            {
                <p class="text-center text-secondary py-4 mb-0">You have not accepted any tasks yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr><th>#</th><th>Category</th><th>Address</th><th>Agreed</th><th>Status</th><th>Customer</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var job in Model.MyJobs)
                        {
                            <tr>
                                <td class="text-secondary">@job.Id</td>
                                <td>
                                    <span class="badge text-bg-light border">@job.CategoryName</span>
                                    @if (job.WasAssignedBySupport)
                                    {
                                        <div class="small text-secondary mt-1" style="max-width:16rem">
                                            Given to you by support: @job.AssignmentNote
                                        </div>
                                    }
                                    @if (job.CategoryId != profile.SkillCategoryId && GigTaskStatus.IsOpen(job.Status))
                                    {
                                        <div class="small text-warning-emphasis mt-1" style="max-width:14rem">
                                            Booked under @job.CategoryName, which is no longer your
                                            skill. Finish it as agreed — you cannot take new work in
                                            this category.
                                        </div>
                                    }
                                </td>
                                <td class="small text-secondary">@job.Address</td>
                                <td class="fw-semibold">₹@job.EffectiveAmount.ToString("N0")</td>
                                <td><span class="badge badge-@job.Status text-white">@job.StatusLabel</span></td>
                                <td>@(job.CustomerName ?? "—")</td>
                                <td>
                                    <div class="row-actions justify-end">
                                        @if (GigTaskStatus.CanTransition(job.Status, GigTaskStatus.InProgress))
                                        {
                                            <form method="post" asp-action="UpdateStatus" asp-route-id="@job.Id"
                                                  data-confirm-title="Start this job?"
                                                  data-confirm="@($"Start only once you have reached {job.Address}. The customer is told the work has begun, and the job cannot go back to accepted.")"
                                                  data-confirm-icon="question"
                                                  data-confirm-ok="Yes, I have reached">
                                                <input type="hidden" name="status" value="@GigTaskStatus.InProgress" />
                                                <button type="submit" class="btn btn-sm btn-primary">Start</button>
                                            </form>
                                        }
                                        @if (GigTaskStatus.CanTransition(job.Status, GigTaskStatus.Completed))
                                        {
                                            <button type="button" class="btn btn-sm btn-success"
                                                    data-bs-toggle="modal" data-bs-target="#complete-modal-@job.Id">
                                                Complete
                                            </button>
                                        }
                                        @if (GigTaskStatus.CanTransition(job.Status, GigTaskStatus.Cancelled))
                                        {
                                            <form method="post" asp-action="UpdateStatus" asp-route-id="@job.Id"
                                                  data-confirm="Cancel task #@job.Id?">
                                                <input type="hidden" name="status" value="@GigTaskStatus.Cancelled" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

@foreach (var job in Model.MyJobs.Where(j => GigTaskStatus.CanTransition(j.Status, GigTaskStatus.Completed)))
{
    <div class="modal fade" id="complete-modal-@job.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-action="UpdateStatus" asp-route-id="@job.Id" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Close job #@job.Id</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body gig-form">
                    <p class="small text-secondary mb-3">
                        ₹@job.EffectiveAmount.ToString("N0") will be credited to your balance and the
                        customer will be asked to rate you. This cannot be undone.
                    </p>
                    <input type="hidden" name="status" value="@GigTaskStatus.Completed" />
                    <div class="mb-3">
                        <label class="form-label required d-block">How was @(job.CustomerName ?? "this customer")?</label>
                        <partial name="_StarInput" model="@($"complete-{job.Id}")" />
                        <div class="form-text">
                            Your rating is required to close the job. It is not shown to the customer.
                        </div>
                    </div>
                    <div>
                        <label for="complete-note-@job.Id" class="form-label">Anything worth noting</label>
                        <textarea id="complete-note-@job.Id" name="Feedback" class="form-control" rows="2"
                                  maxlength="500" placeholder="Address was hard to find, payment was prompt"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success">Yes, work is done</button>
                </div>
            </form>
        </div>
    </div>
}
