@model AddressBookViewModel
@{
    var slug = ViewData["PortalSlug"] as string ?? "customer";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
    <h2 class="h5 mb-0">Saved addresses</h2>
    <button type="button" class="btn btn-primary btn-sm ms-auto"
            data-bs-toggle="modal" data-bs-target="#address-modal-new">
        + Add address
    </button>
</div>
<p class="text-secondary small">
    Saved addresses are what you pick when booking, so you never retype them.
    A location pin is what lets us match you with the nearest partner.
</p>

@if (Model.WithoutCoordinates > 0)
{
    <div class="alert alert-info small">
        <strong>@Model.WithoutCoordinates</strong> address(es) have no location pin. They still work
        for booking, but cannot be matched by distance. Edit one and use
        <em>Use my current location</em> to add a pin.
    </div>
}

@if (Model.Addresses.Count == 0)
{
    <div class="card"><div class="card-body">
        <p class="text-center text-secondary py-4 mb-0">
            No addresses saved yet. Add one so booking is a single tap.
        </p>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var address in Model.Addresses)
        {
            <div class="col-md-6">
                <div class="card h-100 @(address.IsDefault ? "border-primary" : "")">
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <span class="badge text-bg-light border">@address.Label</span>
                            @if (address.IsDefault)
                            {
                                <span class="badge text-bg-primary">Default</span>
                            }
                            @if (address.HasCoordinates)
                            {
                                <span class="badge text-bg-success">&#128205; Pinned</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">No pin</span>
                            }
                        </div>

                        <p class="small mb-2">@address.SingleLine</p>

                        <div class="row-actions">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#address-modal-@address.Id">
                                Edit
                            </button>

                            @if (!address.IsDefault)
                            {
                                <form method="post" action="/@slug/addresses/@address.Id/default">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        Make default
                                    </button>
                                </form>
                            }

                            <form method="post" action="/@slug/addresses/@address.Id/delete"
                                  data-confirm="Remove this @address.Label address?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Add modal *@
<div class="modal fade" id="address-modal-new" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add an address</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <partial name="_AddressForm" model="null" />
            </div>
        </div>
    </div>
</div>

@* One edit modal per saved address *@
@foreach (var address in Model.Addresses)
{
    <div class="modal fade" id="address-modal-@address.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit @address.Label address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <partial name="_AddressForm" model="address" />
                </div>
            </div>
        </div>
    </div>
}
