@model UserMenuViewModel

@if (Model.DisplayName is not null)
{
    <div class="d-flex align-items-center gap-2">
        @if (Model.NotificationHref is not null)
        {
            <div class="dropdown" data-notification-menu data-href="@Model.NotificationHref">
                <button class="btn btn-sm btn-light border position-relative dropdown-toggle no-caret"
                        type="button" data-bs-toggle="dropdown" data-bs-display="static"
                        aria-expanded="false"
                        aria-label="Notifications"
                        title="@Model.NotificationCount @Model.NotificationLabel">
                    <partial name="_Icon" model="@("bell")" />
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger"
                          data-notification-badge hidden="@(Model.NotificationCount == 0)">
                        <span data-notification-count>@Model.NotificationCount</span>
                        <span class="visually-hidden">@Model.NotificationLabel</span>
                    </span>
                </button>

                <div class="dropdown-menu dropdown-menu-end p-0 notification-menu">
                    <div class="d-flex align-items-center px-3 py-2 border-bottom">
                        <span class="fw-semibold small">Notifications</span>
                        <a class="ms-auto small text-decoration-none" href="@Model.NotificationHref">See all</a>
                    </div>

                    <div data-notification-list>
                        @if (Model.Recent.Count == 0)
                        {
                            <div class="px-3 py-4 text-center text-secondary small" data-notification-empty>
                                Nothing yet. We will tell you when a job moves.
                            </div>
                        }
                        else
                        {
                            foreach (var note in Model.Recent)
                            {
                                <a class="notification-row@(note.IsRead ? "" : " is-unread")"
                                   href="@(note.Link ?? Model.NotificationHref)">
                                    <span class="notification-icon">@note.Icon</span>
                                    <span class="notification-text">
                                        <span class="notification-title">@note.Title</span>
                                        <span class="notification-body">@note.Body</span>
                                        <span class="notification-age">@note.Age</span>
                                    </span>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        }

        <div class="dropdown">
            <button class="btn btn-sm btn-light border dropdown-toggle no-caret"
                    type="button" data-bs-toggle="dropdown" data-bs-display="static"
                    aria-expanded="false" aria-label="Account" title="@Model.DisplayName">
                @if (Model.PhotoUrl is not null)
                {
                    <img src="@Model.PhotoUrl" alt="" width="20" height="20"
                         class="rounded-circle" style="object-fit:cover" />
                }
                else
                {
                    <partial name="_Icon" model="@("user")" />
                }
            </button>

            <div class="dropdown-menu dropdown-menu-end p-2" style="min-width:14rem">
                <div class="small text-secondary px-1 pb-2">Signed in as <strong>@Model.DisplayName</strong></div>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary flex-fill" href="@Model.ProfilePath">Profile</a>
                    <form method="post" action="@Model.LogoutPath" class="flex-fill">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
