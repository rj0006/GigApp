@model ProfilePageViewModel

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-1">Where you work</h2>
        <p class="text-secondary small">
            Work is matched by distance. Drop a pin on the place you set out from and say how far
            you will travel, and the board shows the nearest jobs first and hides the rest.
        </p>

        <div id="area-status-alert"></div>

        <form id="area-form" class="gig-form row g-3">
            <div class="col-md-6">
                <label for="ServiceRadiusKm" class="form-label required">How far will you travel? (km)</label>
                <input id="ServiceRadiusKm" name="ServiceRadiusKm" type="number" min="1" max="100"
                       class="form-control" required />
                <div class="form-text">Between 1 and 100. Jobs beyond this are hidden from your board.</div>
            </div>

            <div class="col-md-3">
                <label for="BaseCity" class="form-label">Base city</label>
                <input id="BaseCity" name="BaseCity" class="form-control" maxlength="80" placeholder="Gurugram" />
            </div>

            <div class="col-md-3">
                <label for="BasePincode" class="form-label">Base pincode</label>
                <input id="BasePincode" name="BasePincode" class="form-control" inputmode="numeric"
                       maxlength="6" placeholder="122002" />
            </div>

            <div class="col-12">
                <label class="form-label">Location pin</label>
                <div class="row g-2">
                    <div class="col-sm-4">
                        <input id="BaseLatitude" name="BaseLatitude" class="form-control"
                               readonly placeholder="Latitude" />
                    </div>
                    <div class="col-sm-4">
                        <input id="BaseLongitude" name="BaseLongitude" class="form-control"
                               readonly placeholder="Longitude" />
                    </div>
                    <div class="col-sm-4">
                        <button type="button" class="btn btn-outline-primary w-100"
                                data-capture-location data-lat="BaseLatitude" data-lon="BaseLongitude"
                                data-status="area-status">
                            Use my current location
                        </button>
                    </div>
                </div>
                <div id="area-status" class="form-text">
                    Stand at your shop or home when you press this. It is accurate to a few metres.
                </div>
            </div>

            <div class="col-12" id="area-copy-address-wrap" hidden>
                <label for="copy-address" class="form-label">Or copy one of your saved addresses</label>
                <select id="copy-address" class="form-select"
                        data-copy-latlon data-lat="BaseLatitude" data-lon="BaseLongitude"
                        data-city="BaseCity" data-pincode="BasePincode">
                    <option value="">Choose an address</option>
                </select>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save service area</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        function load() {
            App.api.get('/api/partners/me/service-area').then(function (data) {
                var form = data.form;

                $('#ServiceRadiusKm').val(form.serviceRadiusKm);
                $('#BaseCity').val(form.baseCity || '');
                $('#BasePincode').val(form.basePincode || '');
                $('#BaseLatitude').val(form.baseLatitude != null ? form.baseLatitude : '');
                $('#BaseLongitude').val(form.baseLongitude != null ? form.baseLongitude : '');

                $('#area-status-alert').html(data.hasPin
                    ? '<div class="alert alert-success small"><strong>' + data.openTasksInRange
                      + '</strong> open job(s) in your category are within ' + form.serviceRadiusKm + ' km of you right now.</div>'
                    : '<div class="alert alert-warning small"><strong>No location set.</strong> Until you add one you see '
                      + 'every open job in your category, in no particular order.</div>');

                var pinned = data.addresses.filter(function (a) { return a.hasCoordinates; });

                if (pinned.length > 0) {
                    $('#area-copy-address-wrap').prop('hidden', false);
                    $('#copy-address').html('<option value="">Choose an address</option>' + pinned.map(function (a) {
                        return '<option value="' + a.id + '" data-lat="' + a.latitude + '" data-lon="' + a.longitude + '" '
                            + 'data-city="' + Admin.escapeHtml(a.city) + '" data-pincode="' + Admin.escapeHtml(a.pincode) + '">'
                            + Admin.escapeHtml(a.label) + ' — ' + Admin.escapeHtml(a.singleLine) + '</option>';
                    }).join(''));
                } else {
                    $('#area-copy-address-wrap').prop('hidden', true);
                }
            });
        }

        $(function () {
            load();

            $('#area-form').on('submit', function (event) {
                event.preventDefault();

                var lat = $('#BaseLatitude').val();
                var lon = $('#BaseLongitude').val();

                if ((lat && !lon) || (!lat && lon)) {
                    showToast('Error', 'A location needs both a latitude and a longitude.', 'error');
                    return;
                }

                var data = Admin.formToJson(this);
                data.BaseLatitude = lat || null;
                data.BaseLongitude = lon || null;

                App.api.put('/api/partners/me/service-area', data).then(function (result) {
                    showToast('Success', result.hasPin
                        ? 'Saved. You will now see work within ' + result.form.serviceRadiusKm + ' km of your base, nearest first.'
                        : 'Saved. Add a location pin to see work sorted by how near it is.', 'success');
                    load();
                });
            });
        });
    });
</script>
