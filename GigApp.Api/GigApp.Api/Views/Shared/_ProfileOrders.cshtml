@model ProfilePageViewModel

<div class="card">
    <div class="card-body">
        <h2 class="h6 mb-1">Order history</h2>
        <p class="text-secondary small" id="orders-subtitle">Every order you have been on, newest first.</p>

        <div class="row g-2 align-items-end mb-3">
            <div class="col-sm-5">
                <label class="form-label" for="orders-search">Search</label>
                <input class="form-control form-control-sm" id="orders-search" placeholder="Work, address or category" />
            </div>
            <div class="col-sm-4">
                <label class="form-label" for="orders-status">Status</label>
                <select class="form-select form-select-sm" id="orders-status">
                    <option value="">All</option>
                    @foreach (var status in GigTaskStatus.All)
                    {
                        <option value="@status">@status.Replace('_', ' ')</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="button" id="orders-filter-btn" class="btn btn-sm btn-primary">Filter</button>
                <button type="button" id="orders-filter-reset" class="btn btn-sm btn-outline-secondary">Reset</button>
            </div>
        </div>

        <div id="orders-empty" class="text-center text-secondary py-4 mb-0" hidden>No orders match this filter.</div>

        <div id="orders-table-wrap" class="table-responsive" hidden>
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th><th>Work</th><th id="orders-party-header">Partner</th>
                        <th>Amount</th><th>Status</th><th>Booked</th><th class="text-end">Support</th>
                    </tr>
                </thead>
                <tbody id="orders-rows"></tbody>
            </table>
        </div>

        <div id="orders-pager" class="d-flex align-items-center gap-2 mt-3" hidden>
            <span id="orders-pager-summary" class="small text-secondary"></span>
            <div class="btn-group btn-group-sm ms-auto">
                <button type="button" id="orders-prev" class="btn btn-outline-secondary">Previous</button>
                <button type="button" id="orders-next" class="btn btn-outline-secondary">Next</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rate-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rate-modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body gig-form">
                <p class="small text-secondary mb-3" id="rate-modal-summary"></p>
                <div class="mb-3">
                    <label class="form-label required d-block">How was the work?</label>
                    <div class="star-input">
                        @for (var n = RatingScale.Maximum; n >= RatingScale.Minimum; n--)
                        {
                            <input type="radio" name="rate-stars" value="@n" id="rate-star-@n" />
                            <label for="rate-star-@n" title="@RatingScale.Label(n)">&#9733;</label>
                        }
                    </div>
                    <div class="form-text">Ratings are how the next customer knows who to trust.</div>
                </div>
                <div>
                    <label for="rate-feedback" class="form-label">Feedback</label>
                    <textarea id="rate-feedback" class="form-control" rows="2" maxlength="500"
                              placeholder="Came on time and cleaned up afterwards"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Not now</button>
                <button type="button" id="rate-modal-submit" class="btn btn-sm btn-primary">Send rating</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="help-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="help-modal-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body gig-form">
                <p class="small text-secondary mb-3" id="help-modal-summary"></p>
                <div class="mb-3">
                    <label for="help-topic" class="form-label required">What is this about?</label>
                    <select id="help-topic" class="form-select" required>
                        @foreach (var topic in EnquiryTopics.All)
                        {
                            <option value="@topic">@EnquiryTopics.Label(topic)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="help-message" class="form-label required">Tell us what happened</label>
                    <textarea id="help-message" class="form-control" rows="4"
                              required minlength="10" maxlength="1000"
                              placeholder="Be specific — what went wrong, and what you would like done about it"></textarea>
                    <div class="form-text">Our team reads every enquiry and replies here with what was done.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="help-modal-submit" class="btn btn-sm btn-primary">Send to support</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="enquiry-view-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="enquiry-view-title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="enquiry-view-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        var state = { page: 1, search: '', status: '' };
        var currentOrderId = null;
        var ordersById = {};

        function inr(amount) {
            return '₹' + Math.round(amount).toLocaleString('en-IN');
        }

        function row(order, isPartner, ratings, enquiries) {
            var rating = ratings[order.id];
            var enquiry = enquiries[order.id];

            var statusCell = '<span class="badge badge-' + order.status + ' text-white">' + Admin.escapeHtml(order.statusLabel) + '</span>';

            if (rating) {
                var stars = '<span class="stars-read">';
                for (var n = 1; n <= 5; n++) stars += '<span class="' + (n <= rating.stars ? '' : 'star-off') + '">&#9733;</span>';
                stars += '</span>';
                statusCell += '<div class="mt-1">' + stars + '</div>';
            } else if (!isPartner && order.status === 'completed') {
                statusCell += '<div class="mt-1"><button type="button" class="btn btn-sm btn-outline-primary" data-rate="' + order.id + '">Rate partner</button></div>';
            }

            var supportCell = enquiry
                ? '<button type="button" class="btn btn-sm btn-outline-secondary" data-view-enquiry="' + order.id + '">'
                  + '<span class="badge ' + enquiry.statusBadgeClass + '">' + enquiry.statusLabel + '</span> ' + Admin.escapeHtml(enquiry.reference) + '</button>'
                : '<button type="button" class="btn btn-sm btn-outline-primary" data-help="' + order.id + '">Need help?</button>';

            return '<tr>'
                + '<td class="text-secondary">' + order.id + '</td>'
                + '<td><div>' + Admin.escapeHtml(order.serviceItemName || order.categoryName) + '</div>'
                + '<span class="badge text-bg-light border">' + Admin.escapeHtml(order.categoryName) + '</span>'
                + (order.isInstant ? ' <span class="badge text-bg-success">Fixed price</span>' : '')
                + '<div class="small text-secondary">' + Admin.escapeHtml(order.address) + '</div></td>'
                + '<td>' + Admin.escapeHtml((isPartner ? order.customerName : order.partnerName) || '—')
                + (order.wasAssignedBySupport ? '<div class="small text-secondary">Assigned by support</div>' : '') + '</td>'
                + '<td class="fw-semibold">' + inr(order.effectiveAmount) + '</td>'
                + '<td>' + statusCell + '</td>'
                + '<td class="small text-secondary">' + new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + '</td>'
                + '<td class="text-end">' + supportCell + '</td>'
                + '</tr>';
        }

        function load() {
            var url = '/api/profile/orders?page=' + state.page + '&pageSize=10'
                + (state.search ? '&search=' + encodeURIComponent(state.search) : '')
                + (state.status ? '&status=' + state.status : '');

            App.api.get(url).then(function (data) {
                var list = data.orders;

                $('#orders-subtitle').text('Every order you have been on, newest first. Raise a support enquiry if something about '
                    + (data.isPartner ? 'a job' : 'an order') + ' needs sorting out.');
                $('#orders-party-header').text(data.isPartner ? 'Customer' : 'Partner');

                $('#orders-empty').prop('hidden', list.totalCount > 0);
                $('#orders-table-wrap').prop('hidden', list.totalCount === 0);
                $('#orders-pager').prop('hidden', list.totalCount === 0);

                ordersById = {};
                list.items.forEach(function (o) { ordersById[o.id] = o; });

                $('#orders-rows').html(list.items.map(function (o) { return row(o, data.isPartner, data.ratings, data.enquiries); }).join(''));
                $('#orders-rows').data('isPartner', data.isPartner);
                $('#orders-rows').data('enquiries', data.enquiries);

                $('#orders-pager-summary').text(list.totalCount === 0
                    ? ''
                    : 'Showing ' + list.firstRow + '–' + list.lastRow + ' of ' + list.totalCount);

                $('#orders-prev').prop('disabled', !list.hasPrevious);
                $('#orders-next').prop('disabled', !list.hasNext);
            });
        }

        $(function () {
            load();

            $('#orders-filter-btn').on('click', function () {
                state.search = $('#orders-search').val().trim();
                state.status = $('#orders-status').val();
                state.page = 1;
                load();
            });

            $('#orders-search').on('keydown', function (event) {
                if (event.which === 13) {
                    event.preventDefault();
                    $('#orders-filter-btn').click();
                }
            });

            $('#orders-filter-reset').on('click', function () {
                $('#orders-search').val('');
                $('#orders-status').val('');
                state = { page: 1, search: '', status: '' };
                load();
            });

            $('#orders-prev').on('click', function () { state.page -= 1; load(); });
            $('#orders-next').on('click', function () { state.page += 1; load(); });

            $('#orders-rows').on('click', '[data-rate]', function () {
                var order = ordersById[$(this).data('rate')];
                currentOrderId = order.id;

                $('#rate-modal-title').text('Rate order #' + order.id);
                $('#rate-modal-summary').text((order.serviceItemName || order.categoryName) + ' · ' + (order.partnerName || 'your partner'));
                $('input[name="rate-stars"]').prop('checked', false);
                $('#rate-feedback').val('');

                new bootstrap.Modal(document.getElementById('rate-modal')).show();
            });

            $('#rate-modal-submit').on('click', function () {
                var stars = $('input[name="rate-stars"]:checked').val();

                if (!stars) {
                    showToast('Error', 'Choose between one and five stars.', 'error');
                    return;
                }

                App.api.post('/api/gigtasks/' + currentOrderId + '/rate', { stars: stars, feedback: $('#rate-feedback').val() })
                    .then(function () {
                        bootstrap.Modal.getInstance(document.getElementById('rate-modal')).hide();
                        showToast('Success', 'Rating sent.', 'success');
                        load();
                    });
            });

            $('#orders-rows').on('click', '[data-help]', function () {
                var order = ordersById[$(this).data('help')];
                currentOrderId = order.id;

                $('#help-modal-title').text('Need help with order #' + order.id + '?');
                $('#help-modal-summary').text((order.serviceItemName || order.categoryName) + ' · '
                    + inr(order.effectiveAmount) + ' · ' + new Date(order.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }));
                $('#help-topic').prop('selectedIndex', 0);
                $('#help-message').val('');

                new bootstrap.Modal(document.getElementById('help-modal')).show();
            });

            $('#help-modal-submit').on('click', function () {
                App.api.post('/api/profile/orders/' + currentOrderId + '/help',
                    { topic: $('#help-topic').val(), message: $('#help-message').val() }, { silent: true })
                    .then(function (enquiry) {
                        bootstrap.Modal.getInstance(document.getElementById('help-modal')).hide();
                        showToast('Success', 'We have noted your complaint. Our team will connect with you shortly. Your reference is ' + enquiry.reference + '.', 'success');
                        load();
                    })
                    .catch(function (error) { showToast('Error', error.message, 'error'); });
            });

            $('#orders-rows').on('click', '[data-view-enquiry]', function () {
                var order = ordersById[$(this).data('view-enquiry')];
                var enquiry = ($('#orders-rows').data('enquiries') || {})[order.id];
                if (!enquiry) return;

                $('#enquiry-view-title').text(enquiry.reference);

                var html = '<dl class="row mb-0 small">'
                    + '<dt class="col-4">Order</dt><dd class="col-8">#' + enquiry.gigTaskId + '</dd>'
                    + '<dt class="col-4">About</dt><dd class="col-8">' + Admin.escapeHtml(enquiry.topicLabel) + '</dd>'
                    + '<dt class="col-4">Raised</dt><dd class="col-8">'
                    + new Date(enquiry.createdAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }) + '</dd>'
                    + '<dt class="col-4">Status</dt><dd class="col-8"><span class="badge ' + enquiry.statusBadgeClass + '">' + enquiry.statusLabel + '</span></dd>'
                    + '<dt class="col-4">You wrote</dt><dd class="col-8">' + Admin.escapeHtml(enquiry.message) + '</dd>';

                if (enquiry.resolution) {
                    html += '<dt class="col-4">Our reply</dt><dd class="col-8">' + Admin.escapeHtml(enquiry.resolution)
                        + '<div class="text-secondary mt-1">' + Admin.escapeHtml(enquiry.resolvedByName || '') + ' · '
                        + new Date(enquiry.resolvedAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) + '</div></dd>';
                }

                html += '</dl>';

                if (enquiry.isLive) {
                    html += '<p class="small text-secondary mt-3 mb-0">Our team will connect with you shortly. Quote '
                        + '<strong>' + Admin.escapeHtml(enquiry.reference) + '</strong> if you call.</p>';
                }

                $('#enquiry-view-body').html(html);
                new bootstrap.Modal(document.getElementById('enquiry-view-modal')).show();
            });
        });
    });
</script>
