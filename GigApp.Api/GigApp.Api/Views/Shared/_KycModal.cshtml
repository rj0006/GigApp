<div class="modal fade" id="kyc-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <span id="kyc-modal-name"></span>
                    <span id="kyc-modal-status" class="badge ms-1"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" type="button" role="tab"
                                data-bs-target="#kyc-modal-review">
                            Review
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" type="button" role="tab"
                                data-bs-target="#kyc-modal-history">
                            History
                            <span id="kyc-modal-history-count" class="badge text-bg-secondary ms-1">0</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="kyc-modal-review" role="tabpanel"></div>
                    <div class="tab-pane fade" id="kyc-modal-history" role="tabpanel"></div>
                </div>
            </div>

            <div class="modal-footer flex-wrap gap-2">
                <div class="mb-2 w-100">
                    <label for="kyc-modal-reason" class="form-label small mb-1">
                        Reason <span class="text-secondary">(required to reject)</span>
                    </label>
                    <input id="kyc-modal-reason" class="form-control form-control-sm" maxlength="1000"
                           placeholder="e.g. Selfie does not match the Aadhaar photo" />
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-end w-100">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="kyc-modal-reject" class="btn btn-sm btn-outline-danger">Reject</button>
                    <button type="button" id="kyc-modal-approve" class="btn btn-sm btn-success">Approve</button>
                </div>
            </div>
        </div>
    </div>
</div>
