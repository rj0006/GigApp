@model QuantityStepperModel

<div class="qty-stepper" data-qty-stepper data-service-id="@Model.ServiceItemId">
    <button type="button" data-qty-decrement aria-label="Reduce quantity">&minus;</button>
    <span class="qty-value" data-qty-value>@Model.Quantity</span>
    <button type="button" data-qty-increment
            disabled="@(Model.Quantity >= Model.Maximum)" aria-label="Increase quantity">+</button>
</div>
