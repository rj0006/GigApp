@model ServiceItemDto
@{
    var inCart = ViewData["CartQuantity"] as int? ?? 0;
}

<div class="shop-card" data-service-card data-service-id="@Model.Id">
    <div class="catalog-art">
        @if (Model.ImageUrl is not null)
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
        }
        else
        {
            <span class="catalog-initial">@Model.Name.Substring(0, 1).ToUpperInvariant()</span>
        }
    </div>

    <div class="shop-card-body">
        <div class="shop-card-name">@Model.Name</div>
        <div class="catalog-meta">@Model.CategoryName</div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="shop-card-desc">@Model.Description</div>
        }

        <div class="shop-card-foot">
            <span class="shop-card-price">₹@Model.BasePayout!.Value.ToString("N0")</span>

            <span class="ms-auto" data-cart-control>
                @if (inCart > 0)
                {
                    <partial name="_QuantityStepper" model="@(new QuantityStepperModel {
                        ServiceItemId = Model.Id,
                        Quantity = inCart,
                    })" />
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-uc-outline" data-add-to-cart>Add</button>
                }
            </span>
        </div>
    </div>
</div>
