<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · GigApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <partial name="_ShopHeader" />

    <main class="container py-4">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    @await RenderSectionAsync("Sticky", required: false)

    <footer class="container py-4 small text-secondary border-top mt-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="fw-semibold text-body">GigApp</div>
                <div>Home services at your doorstep.</div>
            </div>
            <div class="col-md-4">
                <div class="fw-semibold text-body">For customers</div>
                <a class="d-block text-decoration-none" href="/services">Browse services</a>
                <a class="d-block text-decoration-none" href="/customer/login">Sign in</a>
            </div>
            <div class="col-md-4">
                <div class="fw-semibold text-body">For professionals</div>
                <a class="d-block text-decoration-none" href="/provider/register">Register as a partner</a>
                <a class="d-block text-decoration-none" href="/provider/login">Partner sign in</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/global.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
