<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · GigApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/customer-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <partial name="_ShopHeader" />
    <partial name="_ZonePicker" />

    <main class="container py-4">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    @await RenderSectionAsync("Sticky", required: false)

    <footer class="site-footer">
      <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <a class="brand-link brand-link-light mb-3" href="/services"><partial name="_Brand" /></a>
                <div>Home services at your doorstep.</div>
            </div>
            <div class="col-md-4">
                <div class="fw-semibold text-body">For customers</div>
                <a class="d-block text-decoration-none" href="/services">Browse services</a>
                <a class="d-block text-decoration-none" href="/customer/login">Sign in</a>
                <partial name="_AppDownload" model="@(new AppDownloadLink("gigapp-customer.apk", "Download the customer app (Android)"))" />
            </div>
            <div class="col-md-4">
                <div class="fw-semibold text-body">For professionals</div>
                <a class="d-block text-decoration-none" href="/provider/login">Become a partner / sign in</a>
                <partial name="_AppDownload" model="@(new AppDownloadLink("gigapp-partner.apk", "Download the partner app (Android)"))" />
            </div>
        </div>
        <partial name="_ContactUs" />
        <div class="site-footer-base border-top mt-4 pt-3 small">&copy; @DateTime.UtcNow.Year GigApp. All rights reserved.</div>
      </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/global.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
