@model OtpAuthViewModel

<div class="card form-card-narrow mx-auto" data-otp-auth>
    <div class="card-body p-4">
        <div id="otp-form-errors"></div>

        <div data-otp-step="phone">
            <h1 class="h5 mb-1">@Model.PortalLabel sign in</h1>
            <p class="text-secondary small mb-3">
                We will send you a text with a verification code.
            </p>

            <form action="@Model.RequestPath" class="gig-form row g-3" data-otp-request-form>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="col-12">
                    <label for="otp-phone" class="form-label required">Mobile number</label>
                    <div class="input-group">
                        <span class="input-group-text">+91</span>
                        <input id="otp-phone" name="Phone" type="tel" class="form-control"
                               inputmode="numeric" maxlength="10" placeholder="9876543210"
                               autocomplete="tel" autofocus required />
                    </div>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-uc-primary w-100">Continue</button>
                </div>
            </form>
        </div>

        <div data-otp-step="code" hidden>
            <h1 class="h5 mb-1">Enter the code</h1>
            <p class="text-secondary small mb-3">
                Sent to <strong>+91 <span data-otp-phone-label></span></strong>.
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-otp-change-number>Change number</button>
            </p>

            <div class="alert alert-warning small" data-otp-dev-code hidden></div>

            <form action="@Model.VerifyPath" class="gig-form row g-3" data-otp-verify-form>
                <input type="hidden" name="Phone" data-otp-phone-field />
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                <div class="col-12">
                    <label for="otp-code" class="form-label required">6-digit code</label>
                    <input id="otp-code" name="Code" class="form-control" inputmode="numeric"
                           maxlength="6" autocomplete="one-time-code" required />
                </div>

                <div class="col-12">
                    <label for="otp-name" class="form-label">Your name</label>
                    <input id="otp-name" name="Name" class="form-control" />
                    <div class="form-text">Only needed the first time, to set up a new account.</div>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-uc-primary w-100">Verify &amp; continue</button>
                </div>
            </form>

            <button type="button" class="btn btn-link btn-sm px-0 text-decoration-none mt-2" data-otp-resend>
                Did not get it? Resend
            </button>

            <p class="small text-center mt-3 mb-0">
                <a href="@Model.PasswordFallbackPath" data-bs-toggle="modal" data-bs-target="#otp-more-options">More options</a>
            </p>
        </div>

        <div data-otp-step="password" hidden>
            <h1 class="h5 mb-1">Enter your password</h1>
            <p class="text-secondary small mb-3">
                Signing in as <strong>+91 <span data-otp-password-phone-label></span></strong>.
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-otp-password-back>Use a code instead</button>
            </p>

            <div id="login-form-errors"></div>

            <form class="gig-form row g-3" data-login-form>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="Identifier" data-otp-password-identifier />

                <div class="col-12">
                    <label for="otp-password" class="form-label required">Password</label>
                    <input id="otp-password" name="Password" type="password" class="form-control"
                           autocomplete="current-password" required />
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-uc-primary w-100">Sign in</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="otp-more-options" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">More options</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <p class="text-secondary small px-3 pt-3 mb-2">Choose another way to sign in</p>
                    <div class="list-group list-group-flush">
                        <button type="button" data-bs-dismiss="modal" data-otp-use-password
                                class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                            <partial name="_Icon" model="@("lock")" />
                            <span>Sign in with password</span>
                        </button>
                    </div>
                    <p class="text-secondary small px-3 pb-3 pt-2 mb-0">
                        More ways to receive a code — phone call, WhatsApp, email — are coming soon.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
