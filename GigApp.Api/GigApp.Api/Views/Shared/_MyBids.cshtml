@model IReadOnlyList<BidDto>
@*
    Partner's own bids. This is deliberately separate from "My jobs" — a bid is
    not a job. The task only moves to My jobs once the customer accepts.
*@
@if (Model.Count == 0)
{
    <p class="text-center text-secondary py-4 mb-0">You have not bid on anything yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Task</th><th>Budget</th><th>Your bid</th>
                    <th>Counter offer</th><th>Status</th><th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var bid in Model)
            {
                <tr>
                    <td>
                        <div class="small">#@bid.GigTaskId · @bid.TaskCategoryName</div>
                        <div class="small text-secondary">@bid.TaskDescription</div>
                    </td>
                    <td class="text-secondary">₹@bid.TaskBudget.ToString("N0")</td>
                    <td class="fw-semibold">₹@bid.Amount.ToString("N0")</td>
                    <td>
                        @if (bid.CounterAmount is not null)
                        {
                            <div class="fw-semibold text-primary">₹@bid.CounterAmount.Value.ToString("N0")</div>
                            @if (!string.IsNullOrWhiteSpace(bid.CounterNote))
                            {
                                <div class="small text-secondary fst-italic">@bid.CounterNote</div>
                            }
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td>
                        @{
                            var badge = bid.Status switch
                            {
                                BidStatus.Accepted => "text-bg-success",
                                BidStatus.Countered => "text-bg-warning",
                                BidStatus.Rejected => "text-bg-danger",
                                BidStatus.Withdrawn => "text-bg-secondary",
                                _ => "text-bg-info",
                            };
                            var label = bid.Status == BidStatus.Pending ? "Waiting on customer" : bid.Status;
                        }
                        <span class="badge @badge text-capitalize">@label</span>
                    </td>
                    <td>
                        <div class="row-actions justify-end">
                            @if (bid.AwaitingPartner)
                            {
                                <form method="post" asp-action="AcceptCounter" asp-route-bidId="@bid.Id">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Accept ₹@bid.CurrentAmount.ToString("N0")
                                    </button>
                                </form>
                            }

                            @if (bid.IsOpen)
                            {
                                @* Re-bidding clears the counter and sends it back to the customer. *@
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#rebid-modal-@bid.Id">
                                    Change bid
                                </button>

                                <form method="post" asp-action="WithdrawBid" asp-route-bidId="@bid.Id"
                                      data-confirm="Withdraw your bid on task #@bid.GigTaskId?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @foreach (var bid in Model.Where(b => b.IsOpen))
    {
        <div class="modal fade" id="rebid-modal-@bid.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-action="PlaceBid" asp-route-id="@bid.GigTaskId" class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Change your bid · task #@bid.GigTaskId</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body gig-form">
                        <p class="small text-secondary">
                            Customer's budget is ₹@bid.TaskBudget.ToString("N0").
                            @if (bid.CounterAmount is not null)
                            {
                                <span>They countered at ₹@bid.CounterAmount.Value.ToString("N0").</span>
                            }
                        </p>
                        <div class="mb-3">
                            <label for="rebid-amount-@bid.Id" class="form-label required">Your amount (₹)</label>
                            <input id="rebid-amount-@bid.Id" name="Amount" type="number" min="1" step="50"
                                   class="form-control" required value="@bid.Amount.ToString("0")" />
                        </div>
                        <div>
                            <label for="rebid-note-@bid.Id" class="form-label">Message to the customer</label>
                            <textarea id="rebid-note-@bid.Id" name="Note" class="form-control" rows="2"
                                      maxlength="500">@bid.Note</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary">Send bid</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
