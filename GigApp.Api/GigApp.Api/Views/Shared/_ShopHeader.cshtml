@{
    var cartCount = ViewData["CartCount"] as int? ?? 0;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isCustomer = signedIn && User.IsInRole(UserRoles.Customer);
}

<header class="shop-header">
    <div class="container py-2 d-flex align-items-center gap-3">
        <a class="navbar-brand fw-bold text-decoration-none" href="/services">
            Gig<span class="text-primary">App</span>
        </a>

        <form method="get" action="/services" class="shop-search d-none d-md-block" role="search">
            <input type="search" name="q" class="form-control form-control-sm"
                   value="@Context.Request.Query["q"]"
                   placeholder="Search for a service, like AC repair" aria-label="Search services" />
        </form>

        <div class="ms-auto d-flex align-items-center gap-2">
            <a class="btn btn-sm btn-uc-outline btn-uc-icon position-relative" href="/cart"
               aria-label="Cart" title="Cart">
                <partial name="_Icon" model="@("cart")" />
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-primary"
                      data-cart-badge hidden="@(cartCount == 0)">
                    <span data-cart-badge-count>@cartCount</span>
                    <span class="visually-hidden">items in your cart</span>
                </span>
            </a>

            @if (isCustomer)
            {
                <a class="btn btn-sm btn-uc-primary btn-uc-icon" href="/customer/profile"
                   aria-label="My account" title="My account">
                    <partial name="_Icon" model="@("user")" />
                </a>
            }
            else
            {
                @* One entry point only — the phone-first login screen signs in an existing
                   number and registers an unknown one, so there is nothing else to link to. *@
                <a class="btn btn-sm btn-uc-outline btn-uc-icon" href="/customer/login"
                   aria-label="Sign in" title="Sign in">
                    <partial name="_Icon" model="@("user")" />
                </a>
            }
        </div>
    </div>
</header>
