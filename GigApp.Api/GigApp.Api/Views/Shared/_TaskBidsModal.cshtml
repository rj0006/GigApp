@model CustomerDashboardViewModel
@*
    One modal per open task, listing the bids received. The customer accepts a
    bid, counters it, or rejects it. Accepting is what assigns the partner.
*@
@foreach (var task in Model.Tasks.Where(t => t.Status == GigTaskStatus.Pending))
{
    var bids = Model.BidsFor(task.Id);

    <div class="modal fade" id="bids-modal-@task.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Bids on task #@task.Id
                        <span class="badge text-bg-light border">@task.CategoryName</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="small text-secondary">
                        @task.Description<br />
                        Your budget: <strong>₹@task.Budget.ToString("N0")</strong>
                    </p>

                    @if (bids.Count == 0)
                    {
                        <p class="text-center text-secondary py-4 mb-0">
                            No bids yet. Partners in this category will see your task and can bid on it.
                        </p>
                    }
                    else
                    {
                        foreach (var bid in bids)
                        {
                            <div class="border rounded p-3 mb-2">
                                <div class="d-flex flex-wrap align-items-start gap-2">
                                    <div>
                                        <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none"
                                                data-bs-toggle="modal" data-bs-target="#partner-modal-@bid.PartnerId">
                                            @bid.PartnerName
                                        </button>
                                        @if (bid.PartnerIsVerified)
                                        {
                                            <span class="badge text-bg-success">Verified</span>
                                        }
                                        <div class="small text-secondary">@bid.PartnerSkillCategory</div>
                                    </div>

                                    <div class="ms-auto text-end">
                                        <div class="h6 mb-0">₹@bid.Amount.ToString("N0")</div>
                                        <div class="small text-secondary">partner's price</div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(bid.Note))
                                {
                                    <p class="small mt-2 mb-0 fst-italic">&ldquo;@bid.Note&rdquo;</p>
                                }

                                @if (bid.CounterAmount is not null)
                                {
                                    <div class="alert alert-warning small mt-2 mb-0">
                                        You countered at <strong>₹@bid.CounterAmount.Value.ToString("N0")</strong> —
                                        waiting for the partner to respond.
                                        @if (!string.IsNullOrWhiteSpace(bid.CounterNote))
                                        {
                                            <div class="fst-italic">&ldquo;@bid.CounterNote&rdquo;</div>
                                        }
                                    </div>
                                }

                                <div class="row-actions mt-3">
                                    <form method="post" asp-action="AcceptBid" asp-route-bidId="@bid.Id"
                                          data-confirm="Assign this task to @bid.PartnerName at ₹@bid.Amount.ToString("N0")?">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Accept ₹@bid.Amount.ToString("N0")
                                        </button>
                                    </form>

                                    @if (bid.Status == BidStatus.Pending)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="collapse" data-bs-target="#counter-@bid.Id">
                                            Counter offer
                                        </button>
                                    }

                                    <form method="post" asp-action="RejectBid" asp-route-bidId="@bid.Id"
                                          data-confirm="Reject @bid.PartnerName's bid?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                </div>

                                @if (bid.Status == BidStatus.Pending)
                                {
                                    <div class="collapse mt-2" id="counter-@bid.Id">
                                        <form method="post" asp-action="CounterBid" asp-route-bidId="@bid.Id"
                                              class="gig-form row g-2 align-items-end">
                                            <div class="col-sm-4">
                                                <label for="counter-amount-@bid.Id" class="form-label required">
                                                    Your counter (₹)
                                                </label>
                                                <input id="counter-amount-@bid.Id" name="CounterAmount" type="number"
                                                       min="1" step="50" class="form-control form-control-sm"
                                                       required value="@task.Budget.ToString("0")" />
                                            </div>
                                            <div class="col-sm-6">
                                                <label for="counter-note-@bid.Id" class="form-label">Message</label>
                                                <input id="counter-note-@bid.Id" name="CounterNote"
                                                       class="form-control form-control-sm" maxlength="500"
                                                       placeholder="Optional" />
                                            </div>
                                            <div class="col-sm-2">
                                                <button type="submit" class="btn btn-sm btn-primary w-100">Send</button>
                                            </div>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}
