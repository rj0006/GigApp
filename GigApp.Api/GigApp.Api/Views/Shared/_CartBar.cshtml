@model CartViewDto

<div class="cart-bar">
    <div class="container d-flex align-items-center gap-3">
        <div>
            <div class="fw-semibold">₹@Model.Total.ToString("N0")</div>
            <div class="small text-secondary">
                @Model.ItemCount item@(Model.ItemCount == 1 ? "" : "s") in your cart
            </div>
        </div>
        <a class="btn btn-primary ms-auto" href="/cart">View cart</a>
    </div>
</div>
