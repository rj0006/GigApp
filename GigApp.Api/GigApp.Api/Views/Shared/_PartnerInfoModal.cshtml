@model PartnerPublicDto
@{
    var modalId = $"partner-modal-{Model.Id}";
}
@*
    Customer-facing partner card. Built from PartnerPublicDto on purpose — it
    carries no Aadhaar number and no KYC images, which are for the partner and
    admins only.
*@
<div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@(modalId)-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@(modalId)-title">Partner details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    @if (Model.ProfileImageUrl is not null)
                    {
                        <img src="@Model.ProfileImageUrl" alt="@Model.Name"
                             class="rounded-circle border" width="64" height="64"
                             style="object-fit:cover" />
                    }
                    else
                    {
                        <div class="rounded-circle border d-flex align-items-center justify-content-center
                                    bg-body-tertiary fw-semibold text-secondary"
                             style="width:64px;height:64px;font-size:1.25rem">@Model.Initials</div>
                    }

                    <div>
                        <div class="h6 mb-1">@Model.Name</div>
                        <span class="badge text-bg-light border">@Model.SkillCategoryName</span>
                        @if (Model.IsVerified)
                        {
                            <span class="badge text-bg-success">Verified</span>
                        }
                    </div>
                </div>

                <dl class="row small mb-0">
                    <dt class="col-5">Mobile</dt>
                    <dd class="col-7"><a href="tel:@Model.Phone" class="mono">@Model.Phone</a></dd>

                    <dt class="col-5">Skill</dt>
                    <dd class="col-7">@Model.SkillCategoryName</dd>

                    <dt class="col-5">Jobs completed</dt>
                    <dd class="col-7">@Model.CompletedJobs</dd>

                    <dt class="col-5">Rating</dt>
                    <dd class="col-7">
                        <partial name="_Stars" model="Model.RoundedRating" />
                        @if (Model.RatingCount > 0)
                        {
                            <span class="small text-secondary">
                                @Model.AverageRating!.Value.ToString("0.0")
                                from @Model.RatingCount customer@(Model.RatingCount == 1 ? "" : "s")
                            </span>
                        }
                    </dd>

                    <dt class="col-5">Currently</dt>
                    <dd class="col-7">@(Model.IsAvailable ? "Accepting work" : "Off duty")</dd>

                    <dt class="col-5">Partner since</dt>
                    <dd class="col-7">@Model.MemberSince.ToString("MMM yyyy")</dd>
                </dl>
            </div>

            <div class="modal-footer">
                <a class="btn btn-sm btn-primary" href="tel:@Model.Phone">Call partner</a>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
