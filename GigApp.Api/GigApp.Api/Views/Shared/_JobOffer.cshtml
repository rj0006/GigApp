@model TaskOfferDto
@{
    var task = Model.Task!;
}

<div class="card offer-card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <h2 class="h6 mb-0">This job is yours first</h2>
            <span class="badge text-bg-primary">Rank @Model.Rank</span>
            <span class="ms-auto small text-secondary">
                Goes to the next partner in
                <span class="offer-countdown" data-countdown="@Model.SecondsLeft">
                    @(Model.SecondsLeft / 60)m @(Model.SecondsLeft % 60)s
                </span>
            </span>
        </div>

        <p class="text-secondary small mb-3">
            You came out nearest and best rated for this one, so you get first refusal. Pass on it
            and it moves straight to the next partner — there is no penalty for saying no.
        </p>

        <div class="row g-3 align-items-center">
            <div class="col-md-8">
                <div class="fw-semibold">@(task.ServiceItemName ?? task.CategoryName)</div>
                <div class="small">@task.Description</div>
                <div class="small text-secondary">
                    @task.Address
                    @if (task.DistanceKm is not null)
                    {
                        <span class="badge text-bg-light border ms-1">@task.DistanceLabel</span>
                    }
                </div>
                @if (task.Urgency != TaskUrgency.Normal)
                {
                    <span class="badge @task.UrgencyBadgeClass mt-1">@task.UrgencyLabel</span>
                }
            </div>

            <div class="col-md-4 text-md-end">
                <div class="h5 mb-2">₹@task.EffectiveAmount.ToString("N0")</div>

                <div class="row-actions justify-end">
                    <form method="post" action="/provider/offers/@Model.Id/respond"
                          data-confirm-title="Take this job?"
                          data-confirm="@($"You will earn ₹{task.EffectiveAmount:N0} before commission for {task.ServiceItemName ?? task.CategoryName} at {task.Address}.")"
                          data-confirm-icon="question"
                          data-confirm-ok="Yes, it is mine">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accepted" value="true" />
                        <button type="submit" class="btn btn-sm btn-success">Accept</button>
                    </form>

                    <form method="post" action="/provider/offers/@Model.Id/respond"
                          data-confirm-title="Pass on this job?"
                          data-confirm="It goes to the next partner straight away. This does not count against you."
                          data-confirm-icon="question"
                          data-confirm-ok="Yes, pass it on">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accepted" value="false" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Pass</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
