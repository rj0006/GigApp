<form id="address-form" class="gig-form row g-3">
    <input type="hidden" id="address-id" />

    <div class="col-md-4">
        <label for="address-label" class="form-label required">Label</label>
        <select id="address-label" name="Label" class="form-select" required>
            @foreach (var label in AddressLabel.All)
            {
                <option value="@label">@label</option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label for="address-house-number" class="form-label">Flat or house number</label>
        <input id="address-house-number" name="HouseNumber" class="form-control" maxlength="50" placeholder="A-101" />
    </div>

    <div class="col-md-4">
        <label for="address-pincode" class="form-label required">Pincode</label>
        <input id="address-pincode" name="Pincode" class="form-control" inputmode="numeric"
               maxlength="6" required placeholder="122001" />
    </div>

    <div class="col-12">
        <label for="address-line1" class="form-label required">Address</label>
        <input id="address-line1" name="Line1" class="form-control" required maxlength="200" placeholder="Building or street" />
    </div>

    <div class="col-md-6">
        <label for="address-line2" class="form-label">Area or sector</label>
        <input id="address-line2" name="Line2" class="form-control" maxlength="200" />
    </div>

    <div class="col-md-6">
        <label for="address-landmark" class="form-label">Landmark</label>
        <input id="address-landmark" name="Landmark" class="form-control" maxlength="150" placeholder="Near the metro station" />
        <div class="form-text">Often how the partner actually finds the place.</div>
    </div>

    <div class="col-md-6">
        <label for="address-city" class="form-label required">City</label>
        <input id="address-city" name="City" class="form-control" required maxlength="80" />
    </div>

    <div class="col-md-6">
        <label for="address-state" class="form-label">State</label>
        <input id="address-state" name="State" class="form-control" maxlength="80" />
    </div>

    <div class="col-12">
        <div class="border rounded p-2 bg-body-tertiary">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-capture-location
                        data-lat="address-latitude" data-lon="address-longitude"
                        data-status="address-pin-status">
                    &#128205; Use my current location
                </button>

                <span id="address-pin-status" class="small text-secondary"></span>
            </div>

            <input type="hidden" id="address-latitude" name="Latitude" />
            <input type="hidden" id="address-longitude" name="Longitude" />
        </div>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="address-is-default" name="IsDefault" value="true" />
            <label class="form-check-label" for="address-is-default">Use as my default address</label>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" id="address-form-submit" class="btn btn-primary">Save address</button>
    </div>
</form>
