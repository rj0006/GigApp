@model ProfilePageViewModel

<div class="card">
    <div class="card-body">
        <h2 class="h6 mb-1">Post a task</h2>
        <p class="text-secondary small">
            Tell us what needs doing and where. A fixed-price service is booked at the listed rate;
            everything else goes out for partner quotes.
        </p>

        <form id="post-task-form" class="gig-form row g-3">
            <div class="col-md-6">
                <label for="CategoryPicker" class="form-label required">Category</label>
                <input id="CategoryPicker" class="form-control" placeholder="Start typing to choose"
                       data-master="skill-category" data-target="CategoryId" data-alert="category" />
                <input type="hidden" id="CategoryId" name="CategoryId" />
            </div>

            <div class="col-md-6">
                <label for="ServicePicker" class="form-label required">Service</label>
                <input id="ServicePicker" class="form-control" placeholder="Pick a category first"
                       data-master="service-item" data-target="ServiceItemId"
                       data-parent="CategoryId" data-alert="service"
                       data-price-field="Budget" data-price-note="budget-note"
                       data-price-fixed-note="Fixed price for this service. The first available partner takes it, so there is no bidding." />
                <input type="hidden" id="ServiceItemId" name="ServiceItemId" value="" />
            </div>

            <div class="col-md-6">
                <label for="Budget" class="form-label required">Budget (₹)</label>
                <input id="Budget" name="Budget" type="number" min="0" step="50"
                       class="form-control" required value="500" />
                <div id="budget-note" class="form-text">Partners bid against this.</div>
            </div>

            <div class="col-md-6">
                <label for="Urgency" class="form-label required">How soon?</label>
                <select id="Urgency" name="Urgency" class="form-select" required>
                    <option value="@TaskUrgency.Urgent">Urgent — today</option>
                    <option value="@TaskUrgency.Normal" selected>Normal — in a few days</option>
                    <option value="@TaskUrgency.Flexible">Flexible — no rush</option>
                </select>
                <div class="form-text">Urgent tasks show first to partners.</div>
            </div>

            <div class="col-12">
                <label for="Description" class="form-label required">What needs doing?</label>
                <textarea id="Description" name="Description" class="form-control" rows="3" required
                          minlength="5" placeholder="Deep clean a 2BHK flat, including kitchen and balcony"></textarea>
            </div>

            <div class="col-md-6">
                <label for="AddressId" class="form-label required">Where is it needed?</label>
                <div id="post-task-no-address" class="alert alert-warning small mb-0" hidden>
                    You have no saved addresses yet.
                    <button type="button" id="post-task-add-address" class="btn btn-sm btn-warning ms-1">Add one now</button>
                </div>
                <div id="post-task-address-wrap" hidden>
                    <select id="AddressId" name="AddressId" class="form-select" required></select>
                    <div class="form-text">
                        <button type="button" id="post-task-add-another" class="btn btn-link btn-sm p-0 text-decoration-none">
                            + Add another address
                        </button>
                        ·
                        <a href="@Model.SectionPath(ProfileSections.Addresses)">Manage addresses</a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <label for="PreferredDateTime" class="form-label">Preferred date &amp; time</label>
                <input id="PreferredDateTime" name="PreferredDateTime" type="datetime-local" class="form-control" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-uc-primary">Post task</button>
                <a class="btn btn-uc-outline" href="/services">Browse services</a>
            </div>
        </form>
    </div>
</div>

<partial name="_AddAddressModal" />

<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        function loadAddresses(selectId) {
            return App.api.get('/api/addresses').then(function (addresses) {
                $('#post-task-no-address').prop('hidden', addresses.length > 0);
                $('#post-task-address-wrap').prop('hidden', addresses.length === 0);

                $('#AddressId').html(addresses.map(function (a) {
                    return '<option value="' + a.id + '"' + (a.id === selectId || (!selectId && a.isDefault) ? ' selected' : '') + '>'
                        + Admin.escapeHtml(a.label) + ' — ' + Admin.escapeHtml(a.singleLine) + (a.hasCoordinates ? '' : ' (no pin)') + '</option>';
                }).join(''));
            });
        }

        function presetCategory() {
            var categoryId = new URLSearchParams(window.location.search).get('categoryId');
            if (!categoryId) return;

            App.api.get('/api/skillcategories').then(function (categories) {
                var match = categories.filter(function (c) { return String(c.id) === categoryId; })[0];
                if (!match) return;

                $('#CategoryPicker').val(match.name);
                $('#CategoryId').val(match.id);
            });
        }

        $(function () {
            loadAddresses();
            presetCategory();

            $('#post-task-add-address, #post-task-add-another').on('click', function () {
                Admin.openAddressModal(null, function (saved) { loadAddresses(saved.id); });
            });

            $('#post-task-form').on('submit', function (event) {
                event.preventDefault();

                var data = Admin.formToJson(this);
                if (!data.PreferredDateTime) data.PreferredDateTime = null;

                App.api.post('/api/gigtasks', data).then(function (task) {
                    showToast('Success', task.isInstant
                        ? 'Booked at the fixed price of ' + '₹' + Math.round(task.effectiveAmount).toLocaleString('en-IN') + '. We are finding you the nearest partner now.'
                        : 'Your task has been posted. Partners can now bid on it.', 'success');
                    window.location.href = '@Model.SectionPath(ProfileSections.Tasks)';
                });
            });
        });
    });
</script>
