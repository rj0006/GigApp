@{
    var displayName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : null;
    var pendingKyc = ViewData["PendingKycCount"] as int? ?? 0;
    var sidebar = ViewData["Sidebar"] as IReadOnlyList<MenuNodeDto> ?? Array.Empty<MenuNodeDto>();

    var path = (Context.Request.Path.Value ?? "/admin").ToLowerInvariant().TrimEnd('/');
    if (path.Length == 0) path = "/admin";

    string? Href(MenuItemDto item) => item.Url ?? (item.ControllerName is null || item.ActionName is null
        ? null
        : Url.Action(item.ActionName, item.ControllerName));

    int Badge(string? key) => key == MenuBadgeKeys.PendingKyc ? pendingKyc : 0;

    string NavClass(string? href) =>
        href is not null && href != "/admin" && path.StartsWith(href.ToLowerInvariant())
            ? "nav-link active"
            : href == "/admin" && path == "/admin" ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · GigApp Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary">
    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle" />

    <div class="admin-shell">
        <aside class="sidebar">
            <div class="sidebar-brand d-flex align-items-center gap-2 flex-wrap">
                <a href="@(ViewData["PortalHome"] as string ?? "/admin")"
                   class="fw-bold text-decoration-none text-body">Gig<span class="text-primary">App</span></a>
                <span class="badge text-bg-primary-subtle text-primary-emphasis">Admin</span>
            </div>

            <nav class="nav flex-column pb-4">
                @foreach (var node in sidebar)
                {
                    if (node.Item.IsGroup)
                    {
                        <div class="nav-group">@node.Item.Label</div>

                        foreach (var child in node.Children)
                        {
                            var href = Href(child.Item);
                            if (href is null) { continue; }

                            var count = Badge(child.Item.BadgeKey);

                            <a class="@NavClass(href)" href="@href"
                               target="@(child.Item.OpensInNewTab ? "_blank" : null)"
                               rel="@(child.Item.OpensInNewTab ? "noopener" : null)">
                                <span class="nav-icon">@child.Item.Icon</span> @child.Item.Label
                                @if (count > 0)
                                {
                                    <span class="badge rounded-pill text-bg-warning ms-auto">@count</span>
                                }
                            </a>
                        }
                    }
                    else
                    {
                        var href = Href(node.Item);
                        if (href is not null)
                        {
                            <a class="@NavClass(href)" href="@href">
                                <span class="nav-icon">@node.Item.Icon</span> @node.Item.Label
                            </a>
                        }
                    }
                }
            </nav>
        </aside>

        <div class="admin-main">
            <header class="admin-header d-flex align-items-center gap-3 px-3 px-lg-4 py-2">
                <label for="sidebar-toggle" class="btn btn-sm btn-outline-secondary d-lg-none mb-0">☰</label>
                <h1 class="h6 mb-0">@ViewData["Title"]</h1>
                <div class="ms-auto">
                    <partial name="_UserMenu" model="@(new UserMenuViewModel
                    {
                        DisplayName = displayName,
                        PortalSlug = "admin",
                        NotificationCount = pendingKyc,
                        NotificationHref = "/admin/approvals",
                        NotificationLabel = "partner KYC waiting for review",
                    })" />
                </div>
            </header>

            <main class="p-3 p-lg-4">
                <partial name="_Flash" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/global.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
