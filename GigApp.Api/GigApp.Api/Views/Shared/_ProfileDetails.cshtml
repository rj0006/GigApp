@model ProfilePageViewModel

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Personal details</h2>

        <form id="details-form" class="gig-form row g-3">
            <div class="col-md-6">
                <label for="details-name" class="form-label required">Full name</label>
                <input id="details-name" name="Name" class="form-control" autocomplete="name" />
            </div>

            <div class="col-md-6">
                <label for="details-phone" class="form-label required">Mobile number</label>
                <input id="details-phone" name="Phone" type="tel" class="form-control" autocomplete="tel" />
                <div class="form-text">Changing this marks your mobile as unverified again.</div>
            </div>

            <div class="col-12">
                <label for="details-email" class="form-label">Email (optional)</label>
                <input id="details-email" name="Email" type="email" class="form-control" autocomplete="email" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Profile photo</h2>

        <form id="photo-form" class="gig-form row g-3">
            <div class="col-md-8">
                <partial name="_ImageUpload" model="@(new ImageUploadModel {
                    Name = "Photo",
                    Label = "Choose a new photo",
                    Hint = "Pick an image to replace the one shown.",
                    Shape = ImageUploadShape.Circle,
                    AllowCamera = true,
                    Required = true,
                })" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-outline-secondary">Upload photo</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h6 mb-1">Change history</h2>
        <p class="text-secondary small">
            Rebuilt from the audit trail — each entry compares that change against the one before it.
        </p>

        <div id="details-history"></div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        function historyTable(history) {
            if (history.length === 0) return '<p class="text-center text-secondary py-3 mb-0">No profile changes recorded yet.</p>';

            var rows = history.map(function (entry) {
                var changes = entry.changes.length === 0
                    ? '<span class="text-secondary">—</span>'
                    : entry.changes.map(function (c) {
                        return '<div><span class="fw-semibold">' + Admin.escapeHtml(c.field) + '</span>: '
                            + '<span class="text-secondary">' + Admin.escapeHtml(c.from || '') + '</span> &rarr; ' + Admin.escapeHtml(c.to || '') + '</div>';
                    }).join('');

                return '<tr><td class="small text-secondary text-nowrap">'
                    + new Date(entry.changedAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false })
                    + '</td><td class="small">' + Admin.escapeHtml(entry.action) + '</td><td class="small">' + changes + '</td></tr>';
            }).join('');

            return '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr>'
                + '<th>When</th><th>Action</th><th>What changed</th></tr></thead><tbody>' + rows + '</tbody></table></div>';
        }

        function load() {
            App.api.get('/api/profile').then(function (user) {
                $('#details-name').val(user.name);
                $('#details-phone').val(user.phone);
                $('#details-email').val(user.email || '');
                Admin.showImagePreview(user.profileImageUrl, 'Photo');
            });

            App.api.get('/api/profile/history').then(function (history) {
                $('#details-history').html(historyTable(history));
            });
        }

        $(function () {
            load();

            $('#details-form').on('submit', function (event) {
                event.preventDefault();

                App.api.put('/api/profile', Admin.formToJson(this)).then(function () {
                    showToast('Success', 'Profile updated.', 'success');
                    load();
                });
            });

            $('#photo-form').on('submit', function (event) {
                event.preventDefault();

                App.api.post('/api/profile/photo', new FormData(this), { silent: true })
                    .then(function () {
                        showToast('Success', 'Profile photo updated.', 'success');
                        load();
                    })
                    .catch(function (error) { showToast('Error', error.message, 'error'); });
            });
        });
    });
</script>
