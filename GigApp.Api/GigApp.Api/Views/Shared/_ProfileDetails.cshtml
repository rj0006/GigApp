@model ProfilePageViewModel

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Personal details</h2>

        <form method="post" action="/@Model.PortalSlug/profile" class="gig-form row g-3">
            @Html.AntiForgeryToken()

            <div class="col-md-6">
                <label asp-for="Form.Name" class="form-label required"></label>
                <input asp-for="Form.Name" class="form-control" autocomplete="name" />
            </div>

            <div class="col-md-6">
                <label asp-for="Form.Phone" class="form-label required"></label>
                <input asp-for="Form.Phone" type="tel" class="form-control" autocomplete="tel" />
                <div class="form-text">Changing this marks your mobile as unverified again.</div>
            </div>

            <div class="col-12">
                <label asp-for="Form.Email" class="form-label"></label>
                <input asp-for="Form.Email" type="email" class="form-control" autocomplete="email" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6 mb-3">Profile photo</h2>

        <form method="post" action="/@Model.PortalSlug/profile/photo"
              enctype="multipart/form-data" class="gig-form row g-3">
            @Html.AntiForgeryToken()

            <div class="col-md-8">
                <label for="photo" class="form-label">Choose a new photo</label>
                <input id="photo" name="photo" type="file" class="form-control"
                       required accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-outline-secondary">Upload photo</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h6 mb-1">Change history</h2>
        <p class="text-secondary small">
            Rebuilt from the audit trail — each entry compares that change against the one before it.
        </p>

        @if (Model.History.Count == 0)
        {
            <p class="text-center text-secondary py-3 mb-0">No profile changes recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th>When</th><th>Action</th><th>What changed</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in Model.History)
                    {
                        <tr>
                            <td class="small text-secondary text-nowrap">
                                @entry.ChangedAt.ToString("dd MMM yyyy, HH:mm")
                            </td>
                            <td class="small">@entry.Action</td>
                            <td class="small">
                                @if (entry.Changes.Count == 0)
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    @foreach (var change in entry.Changes)
                                    {
                                        <div>
                                            <span class="fw-semibold">@change.Field</span>:
                                            <span class="text-secondary">@change.From</span> &rarr; @change.To
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
