@model AdminPartnersViewModel
@{
    var list = Model.Partners;

    // Only the user-management list fills Accounts, and only a super admin may
    // act on them. The endpoints check the policy again — this is convenience.
    var showAccounts = Model.Accounts.Count > 0 && ViewData["IsSuperAdmin"] is true;

    IReadOnlyList<KycHistoryEntryDto> History(int partnerId) =>
        Model.KycHistory.TryGetValue(partnerId, out var entries)
            ? entries
            : Array.Empty<KycHistoryEntryDto>();
}

@if (list.TotalCount == 0)
{
    <p class="text-center text-secondary py-4 mb-0">No partners match this filter.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th><th>Name</th><th>Mobile</th><th>Skill</th>
                    <th>Aadhaar</th><th>Status</th><th>Duty</th><th class="text-end">Review</th>
                    @if (showAccounts) { <th class="text-end">Account</th> }
                </tr>
            </thead>
            <tbody>
            @foreach (var partner in list.Items)
            {
                <tr>
                    <td class="text-secondary">@partner.Id</td>
                    <td>
                        <div class="fw-semibold">@partner.Name</div>
                        @if (!string.IsNullOrEmpty(partner.Email))
                        {
                            <div class="small text-secondary">@partner.Email</div>
                        }
                    </td>
                    <td class="mono">@partner.Phone</td>
                    <td><span class="badge text-bg-light border">@partner.SkillCategoryName</span></td>
                    <td class="mono small">@(partner.MaskedAadhaar ?? "—")</td>
                    <td>
                        <span class="badge @partner.KycBadgeClass">@partner.KycLabel</span>
                        @if (showAccounts && Model.Accounts.TryGetValue(partner.Id, out var status) && !status.IsActive)
                        {
                            <div class="mt-1"><span class="badge text-bg-danger">Deactivated</span></div>
                        }
                    </td>
                    <td class="small text-secondary">@(partner.IsAvailable ? "On duty" : "Off duty")</td>
                    <td class="text-end">
                        @* Opens the per-row modal rendered below the table. *@
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal" data-bs-target="#kyc-modal-@partner.Id"
                                title="View details">
                            &#128065; View
                        </button>
                    </td>
                    @if (showAccounts)
                    {
                        <td class="text-end">
                            @if (Model.Accounts.ContainsKey(partner.Id))
                            {
                                <button type="button" class="btn btn-sm btn-outline-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#account-modal-@Model.Accounts[partner.Id].Id"
                                        title="Reset password or change status">
                                    Manage
                                </button>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="PagerModel.From(list, Context)" />

    @foreach (var partner in list.Items)
    {
        <partial name="_KycModal" model="@(new KycModalViewModel { Partner = partner, History = History(partner.Id) })" />
    }

    @if (showAccounts)
    {
        foreach (var account in Model.Accounts.Values)
        {
            <partial name="_UserAccountModal" model="account" />
        }
    }
}
