@model IReadOnlyList<KycHistoryEntryDto>

@if (Model.Count == 0)
{
    <p class="text-center text-secondary py-4 mb-0">
        No KYC activity has been recorded for this partner yet.
    </p>
}
else
{
    <p class="text-secondary small">
        Every KYC event for this partner, newest first. Taken from the audit trail, so it covers
        registration, every document upload, every skill change and every decision.
    </p>

    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>When</th><th>Action</th><th>Detail</th><th>By</th><th>Status after</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td class="small text-secondary text-nowrap">
                        @entry.At.ToString("dd MMM yyyy")<br />
                        <span class="text-body-tertiary">@entry.At.ToString("HH:mm") UTC</span>
                    </td>
                    <td class="fw-semibold small">@entry.Action</td>
                    <td class="small">
                        @if (!string.IsNullOrWhiteSpace(entry.Detail))
                        {
                            <div>@entry.Detail</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Remark) && entry.Remark != entry.Detail)
                        {
                            <div class="text-secondary">@entry.Remark</div>
                        }
                        @if (string.IsNullOrWhiteSpace(entry.Detail) && string.IsNullOrWhiteSpace(entry.Remark))
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td class="small text-secondary">@(entry.By ?? "—")</td>
                    <td><span class="badge @entry.BadgeClass">@entry.StatusLabel</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
