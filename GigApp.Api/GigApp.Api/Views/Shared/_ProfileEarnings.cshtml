@model ProfilePageViewModel
@{
    var summary = Model.Earnings!.Summary;
}

<h2 class="h5 mb-1">My earnings</h2>
<p class="text-secondary small">
    A job is credited the moment you mark it complete. Commission and tax come off as separate
    lines, so you can always see the full amount the customer agreed.
</p>

@if (summary.Plan is not null)
{
    <div class="alert @(summary.Plan.IsZeroCommission ? "alert-success" : "alert-light border") d-flex flex-wrap align-items-center gap-2">
        <div>
            <strong>@summary.Plan.PlanName plan.</strong>
            @if (summary.Plan.IsZeroCommission)
            {
                <text>You keep the whole job amount — no commission is taken.</text>
            }
            else
            {
                <text>@summary.Plan.CommissionPercent.ToString("0.##")% commission is taken from each job.</text>
            }
        </div>

        @if (summary.Plan.EndsOn is not null)
        {
            <span class="badge text-bg-warning ms-auto">
                Runs out @summary.Plan.EndsOn.Value.ToString("dd MMM yyyy")
            </span>
        }
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0 text-success">₹@summary.Balance.ToString("N2")</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">Available balance</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0">₹@summary.EarnedThisMonth.ToString("N2")</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">Earned this month</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0">₹@summary.LifetimeNet.ToString("N2")</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">
                Lifetime, after deductions
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100"><div class="card-body py-3">
            <div class="h4 mb-0">₹@summary.LifetimePaidOut.ToString("N2")</div>
            <div class="text-secondary text-uppercase" style="font-size:.68rem">Paid out</div>
        </div></div>
    </div>
</div>

@if (Model.Earnings!.BankAccount is null)
{
    <div class="alert alert-warning">
        <strong>No bank account on file.</strong>
        Your balance cannot be paid out until you add one under
        <a href="/provider/profile/bank">Account details</a>.
    </div>
}
else
{
    <div class="alert alert-light border small">
        Payouts go to <strong>@Model.Earnings!.BankAccount.BankName</strong>
        <span class="mono">@Model.Earnings!.BankAccount.MaskedAccountNumber</span>.
        <a href="/provider/profile/bank">Change</a>
    </div>
}

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <h2 class="h6 mb-0">Statement</h2>

            <form method="get" class="ms-auto" data-auto-submit>
                <select name="entryType" class="form-select form-select-sm">
                    <option value="">All entries</option>
                    @foreach (var type in LedgerEntryTypes.All)
                    {
                        <option value="@type" selected="@(Model.Earnings!.EntryTypeFilter == type)">
                            @LedgerEntryTypes.Label(type)
                        </option>
                    }
                </select>
            </form>
        </div>

        <partial name="_LedgerTable" model="Model.Earnings!.Entries" />
    </div>
</div>
