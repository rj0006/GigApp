@model PartnerDto
@*
    KYC review block. The images are served by FilesController after an
    authorization check, so these URLs only work for an admin or the owning
    partner — they are not public static files.
*@
<div class="row g-3">
    <div class="col-md-4">
        <div class="small fw-semibold mb-1">Selfie</div>
        @if (Model.SelfieUrl is not null)
        {
            <a href="@Model.SelfieUrl" target="_blank" rel="noopener noreferrer">
                <img src="@Model.SelfieUrl" alt="Partner selfie"
                     class="img-fluid rounded border" style="max-height:200px" />
            </a>
        }
        else
        {
            <div class="border rounded d-flex align-items-center justify-content-center text-secondary small"
                 style="height:140px">Not submitted</div>
        }
    </div>

    <div class="col-md-4">
        <div class="small fw-semibold mb-1">Aadhaar — front</div>
        @if (Model.AadhaarFrontUrl is not null)
        {
            <a href="@Model.AadhaarFrontUrl" target="_blank" rel="noopener noreferrer">
                <img src="@Model.AadhaarFrontUrl" alt="Aadhaar front"
                     class="img-fluid rounded border" style="max-height:200px" />
            </a>
        }
        else
        {
            <div class="border rounded d-flex align-items-center justify-content-center text-secondary small"
                 style="height:140px">Not submitted</div>
        }
    </div>

    <div class="col-md-4">
        <div class="small fw-semibold mb-1">Aadhaar — back</div>
        @if (Model.AadhaarBackUrl is not null)
        {
            <a href="@Model.AadhaarBackUrl" target="_blank" rel="noopener noreferrer">
                <img src="@Model.AadhaarBackUrl" alt="Aadhaar back"
                     class="img-fluid rounded border" style="max-height:200px" />
            </a>
        }
        else
        {
            <div class="border rounded d-flex align-items-center justify-content-center text-secondary small"
                 style="height:140px">Not submitted</div>
        }
    </div>

    <div class="col-12">
        <span class="small fw-semibold">Aadhaar number:</span>
        @if (string.IsNullOrWhiteSpace(Model.AadhaarNumber))
        {
            <span class="text-secondary small">Not provided</span>
        }
        else
        {
            <span class="mono">@Model.AadhaarNumber</span>
        }
    </div>
</div>
