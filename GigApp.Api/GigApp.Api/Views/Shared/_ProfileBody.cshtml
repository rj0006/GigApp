@model ProfilePageViewModel
@{
    var user = Model.User;

    var sections = new List<(string Key, string Label, string Icon, bool Enabled, string? Note)>
    {
        (ProfileSections.Details, "Profile", "&#128100;", true, null),
    };

    // An administrator is never paid and never booked, so a bank account and a
    // delivery address mean nothing on their account.
    if (!UserRoles.IsAdminRole(user.Role))
    {
        sections.Add((ProfileSections.Bank, "Account details", "&#127974;", true, null));
        sections.Add((ProfileSections.Addresses, "My addresses", "&#128205;", true, null));
    }

    if (Model.ShowKyc)
    {
        sections.Add((ProfileSections.Kyc, "KYC", "&#128196;", true, Model.Partner!.KycLabel));
    }

    sections.Add((ProfileSections.Devices, "Manage devices", "&#128241;", false, "Coming soon"));
    sections.Add((ProfileSections.Settings, "Settings", "&#9881;", true, null));
}

<div class="row g-3">
    <div class="col-lg-3">
        <div class="card mb-3">
            <div class="card-body text-center py-3">
                @if (user.ProfileImageUrl is not null)
                {
                    <img src="@user.ProfileImageUrl" alt="@user.Name"
                         class="rounded-circle border mb-2" width="72" height="72"
                         style="object-fit:cover" />
                }
                else
                {
                    <div class="rounded-circle border d-inline-flex align-items-center justify-content-center
                                bg-body-tertiary text-secondary fw-semibold mb-2"
                         style="width:72px;height:72px;font-size:1.4rem">
                        @(string.IsNullOrWhiteSpace(user.Name) ? "?" : user.Name.Substring(0, 1).ToUpperInvariant())
                    </div>
                }

                <div class="fw-semibold">@user.Name</div>
                <div class="small text-secondary">@user.RoleLabel</div>

                @if (!user.IsPhoneVerified)
                {
                    <span class="badge text-bg-warning mt-2">Mobile not verified</span>
                }
            </div>
        </div>

        <div class="list-group profile-nav">
            @foreach (var link in sections)
            {
                var active = link.Key == Model.Section ? " active" : "";

                if (!link.Enabled)
                {
                    <span class="list-group-item list-group-item-action disabled d-flex justify-content-between align-items-center">
                        <span>@Html.Raw(link.Icon) @link.Label</span>
                        <span class="badge text-bg-light border">@link.Note</span>
                    </span>
                }
                else
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center@(active)"
                       href="@Model.SectionPath(link.Key)">
                        <span>@Html.Raw(link.Icon) @link.Label</span>
                        @if (link.Note is not null)
                        {
                            <span class="badge @(link.Key == ProfileSections.Kyc ? Model.Partner!.KycBadgeClass : "text-bg-light border")">
                                @link.Note
                            </span>
                        }
                    </a>
                }
            }
        </div>
    </div>

    <div class="col-lg-9">
        @switch (Model.Section)
        {
            case ProfileSections.Bank:
                <partial name="_ProfileBank" model="Model" />
                break;

            case ProfileSections.Addresses:
                <partial name="_ProfileAddresses" model="Model" />
                break;

            case ProfileSections.Kyc:
                <partial name="_ProfileKyc" model="Model" />
                break;

            case ProfileSections.Settings:
                <partial name="_ProfileSettings" model="Model" />
                break;

            default:
                <partial name="_ProfileDetails" model="Model" />
                break;
        }
    </div>
</div>
