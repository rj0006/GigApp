@model ProfilePageViewModel
@{
    // One profile UI for all three portals; only the surrounding layout differs.
    var user = Model.User;
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body text-center">
                @if (user.ProfileImageUrl is not null)
                {
                    <img src="@user.ProfileImageUrl" alt="@user.Name"
                         class="rounded-circle border mb-2" width="96" height="96"
                         style="object-fit:cover" />
                }
                else
                {
                    <div class="rounded-circle border d-inline-flex align-items-center justify-content-center
                                bg-body-tertiary text-secondary fw-semibold mb-2"
                         style="width:96px;height:96px;font-size:1.75rem">
                        @(string.IsNullOrWhiteSpace(user.Name) ? "?" : user.Name.Substring(0, 1).ToUpperInvariant())
                    </div>
                }

                <div class="h6 mb-0">@user.Name</div>
                <div class="small text-secondary text-capitalize">@user.Role</div>

                @if (!user.IsPhoneVerified)
                {
                    <span class="badge text-bg-warning mt-2">Mobile not verified</span>
                }

                <form method="post" asp-action="UpdateProfilePhoto"
                      enctype="multipart/form-data" class="mt-3 text-start">
                    <label for="photo" class="form-label small fw-semibold">Change photo</label>
                    <input id="photo" name="photo" type="file" class="form-control form-control-sm mb-2"
                           required accept=".jpg,.jpeg,.png,.webp" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">Upload photo</button>
                    <div class="form-text">JPG, PNG or WEBP, up to 5 MB.</div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6 mb-3">Account details</h2>

                <form method="post" asp-action="UpdateProfile" class="gig-form row g-3">
                    <div class="col-md-6">
                        <label asp-for="Form.Name" class="form-label required"></label>
                        <input asp-for="Form.Name" class="form-control" autocomplete="name" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Form.Phone" class="form-label required"></label>
                        <input asp-for="Form.Phone" type="tel" class="form-control" autocomplete="tel" />
                        <div class="form-text">Changing this marks your mobile as unverified again.</div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Form.Email" class="form-label"></label>
                        <input asp-for="Form.Email" type="email" class="form-control" autocomplete="email" />
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6 mb-3">Change password</h2>

                <form method="post" asp-action="ChangePassword" class="gig-form row g-3">
                    <div class="col-12">
                        <label for="CurrentPassword" class="form-label required">Current password</label>
                        <input id="CurrentPassword" name="CurrentPassword" type="password"
                               class="form-control" required autocomplete="current-password" />
                    </div>

                    <div class="col-md-6">
                        <label for="NewPassword" class="form-label required">New password</label>
                        <input id="NewPassword" name="NewPassword" type="password"
                               class="form-control" required autocomplete="new-password" />
                        <div class="form-text">@ValidationPatterns.PasswordMessage</div>
                    </div>

                    <div class="col-md-6">
                        <label for="ConfirmPassword" class="form-label required">Confirm new password</label>
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password"
                               class="form-control" required autocomplete="new-password" />
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Change password</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-1">Change history</h2>
                <p class="text-secondary small">
                    Rebuilt from the audit trail — each entry compares that change against the one before it.
                </p>

                @if (Model.History.Count == 0)
                {
                    <p class="text-center text-secondary py-3 mb-0">No profile changes recorded yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr><th>When</th><th>Action</th><th>What changed</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var entry in Model.History)
                            {
                                <tr>
                                    <td class="small text-secondary text-nowrap">
                                        @entry.ChangedAt.ToString("dd MMM yyyy, HH:mm")
                                    </td>
                                    <td class="small">@entry.Action</td>
                                    <td class="small">
                                        @if (entry.Changes.Count == 0)
                                        {
                                            <span class="text-secondary">—</span>
                                        }
                                        else
                                        {
                                            @foreach (var change in entry.Changes)
                                            {
                                                <div>
                                                    <strong>@change.Field:</strong>
                                                    <span class="text-secondary">@change.From</span>
                                                    &rarr;
                                                    <span>@change.To</span>
                                                </div>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.Remark))
                                        {
                                            <div class="text-secondary fst-italic">@entry.Remark</div>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
