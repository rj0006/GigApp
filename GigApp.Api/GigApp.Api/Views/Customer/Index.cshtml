@model CustomerCatalogViewModel
@{
    ViewData["Portal"] = "Customer";
    ViewData["LogoutPath"] = "/customer/logout";
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
    <h1 class="h4 mb-0">Hello, @Model.Name</h1>
    <div class="ms-auto d-flex gap-2">
        @if (Model.OpenTaskCount > 0)
        {
            <a class="btn btn-sm btn-outline-primary" href="/customer/profile/tasks">
                My tasks <span class="badge text-bg-primary">@Model.OpenTaskCount</span>
            </a>
        }
        <a class="btn btn-sm btn-primary" href="/customer/profile/post">Post a task</a>
    </div>
</div>
<p class="text-secondary small">
    Pick what you need done. A fixed-price service is booked at the listed rate; for anything else
    partners send you their quotes.
</p>

@if (Model.Categories.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5 text-secondary">
            No services are listed yet. Please check back shortly.
        </div>
    </div>
}
else
{
    <div class="catalog-grid">
        @foreach (var tile in Model.Categories)
        {
            var category = tile.Category;

            <a class="catalog-tile" href="/customer/profile/post?categoryId=@category.Id">
                <div class="catalog-art">
                    @if (category.ImageUrl is not null)
                    {
                        <img src="@category.ImageUrl" alt="@category.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="catalog-initial">@category.Name.Substring(0, 1).ToUpperInvariant()</span>
                    }
                </div>
                <div class="catalog-body">
                    <div class="catalog-name">@category.Name</div>
                    <div class="catalog-meta">
                        @tile.ServiceCount service@(tile.ServiceCount == 1 ? "" : "s")
                    </div>
                    @if (tile.StartingFrom is not null)
                    {
                        <div class="catalog-price">From ₹@tile.StartingFrom.Value.ToString("N0")</div>
                    }
                </div>
            </a>
        }
    </div>
}
