@model RegisterCustomerViewModel
@{
    ViewData["Portal"] = "Customer";
}

<div class="card form-card-narrow mx-auto">
    <div class="card-body p-4">
        <h1 class="h5 mb-1">Create a customer account</h1>
        <p class="text-secondary small">Your mobile number is your account ID. Email is optional.</p>

        <partial name="_ValidationSummary" />

        <form method="post" asp-action="Register" class="gig-form row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label required"></label>
                <input asp-for="Name" class="form-control" autocomplete="name" autofocus />
            </div>

            <div class="col-12">
                <label asp-for="Phone" class="form-label required"></label>
                <input asp-for="Phone" type="tel" class="form-control"
                       autocomplete="tel" placeholder="9876543210" />
            </div>

            <div class="col-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
            </div>

            <div class="col-12">
                <label asp-for="Password" class="form-label required"></label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <div class="form-text">@ValidationPatterns.PasswordMessage</div>
            </div>

            <div class="col-12">
                <label asp-for="ConfirmPassword" class="form-label required"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary w-100">Create account</button>
            </div>
        </form>

        <p class="small text-secondary mt-3 mb-0">
            Already registered? <a asp-action="Login">Sign in</a>
        </p>
    </div>
</div>
